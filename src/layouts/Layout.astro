---
import { getTranslations } from '../i18n/translations';
import { config } from '../config';
import Nav from '../components/Nav.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { hasGermanVersion, localeHref, localeUrl, siteUrl } from '../utils/paths';
import '@fontsource/sora/400.css';
import '@fontsource/sora/500.css';
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '@fontsource/sora/800.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'de';
  /** Short label for the breadcrumb trail. Falls back to the full title. */
  breadcrumb?: string;
}

const { lang = (Astro.currentLocale as 'en' | 'de') || 'en' } = Astro.props;
const t = getTranslations(lang);

const title = Astro.props.title || t.seo.title;
const description = Astro.props.description || t.seo.description;

// SEO URLs — derive per-page so each route self-canonicalizes.
// `basePath` is the locale-independent route without slashes ('' for the
// homepage, 'about', 'guides/zone-2-endurance-training'). Both locale URLs are
// built from it through the shared helper, so canonical, hreflang, the language
// switch and every internal link agree on one URL shape.
const basePath = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '')
  .replace(/^\/de(?=\/|$)/, '')
  .replace(/^\/+|\/+$/g, '');
const enUrl = localeUrl('en', basePath);
const deUrl = localeUrl('de', basePath);
const canonicalUrl = lang === 'de' ? deUrl : enUrl;
// The legal pages are English-only, so they get no hreflang set at all rather
// than one half of it pointing at a URL that does not exist.
const isTranslated = hasGermanVersion(basePath);

// Store logo + preferred OG image, referenced from meta + JSON-LD below.
const ogImage = `${siteUrl}/assets/screenshots/endure-dashboard.min.jpeg`;
const orgLogo = `${siteUrl}/assets/ENDURE_lockup_exact_icon_4k.png`;
// operatingSystem for schema, derived from actual availability so it never drifts.
const availableOs = Object.entries(config.platforms)
  .filter(([, p]) => p.available)
  .map(([key]) => ({ ios: 'iOS', android: 'Android', windows: 'Windows', macos: 'macOS' }[key]))
  .join(', ');
// Store listing URLs, reused for schema downloadUrl/installUrl and the
// Organization entity graph (sameAs) — derived from availability like the OS list.
const storeUrls = Object.values(config.platforms)
  .filter((p) => p.available && p.url)
  .map((p) => p.url as string);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Google Consent Mode v2: default-denied in EEA/UK/CH until the cookie
      // banner explicitly updates the state on user accept. This tells Google's
      // ad stack that consent is being managed externally, so Funding Choices
      // (Google's own CMP) won't inject its own banner.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
        region: ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB','CH']
      });
    </script>

    <!--
      AdSense loader, placed statically so the AdSense verification crawler can
      discover it. type="text/plain" prevents the browser from fetching or
      executing it; CookieBanner re-inserts it as a real script on user accept.
    -->
    <script
      is:inline
      type="text/plain"
      data-consent="adsense"
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6061843247884777"
      crossorigin="anonymous"
    ></script>

    <slot name="head" />
    
    <!-- Favicons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicons/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicons/android-chrome-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/favicons/site.webmanifest" />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Hreflang for Multilingual SEO -->
    {isTranslated && (
      <Fragment>
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="de" href={deUrl} />
        <link rel="alternate" hreflang="x-default" href={enUrl} />
      </Fragment>
    )}
    
    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="ENDURE" />
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_DE'} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Fonts -->
    <!-- Fonts -->
    <!-- Inter font is now imported in the frontmatter via @fontsource/inter -->
    
    <!-- Styles -->
    <style is:global>
      @import "../styles/global.css";
    </style>
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ENDURE",
      "applicationCategory": "HealthApplication",
      "operatingSystem": availableOs,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": description,
      "screenshot": ogImage,
      "inLanguage": lang,
      "downloadUrl": storeUrls,
      "installUrl": storeUrls,
      "about": "Indoor cycling training app with smart trainer connectivity and advanced ride analytics (FTP & VO2max tracking). No automated training plans.",
      "featureList": [
        "FTP & VO2max trend tracking",
        "In-ride lactate logging with automatic LT1/LT2 estimation",
        "Native CORE body temperature sensor integration with live heat zones",
        "Climbing Efficiency (VAM-based climb scoring)",
        "Structured workout library",
        "Smart trainer connectivity via Bluetooth",
        "Virtual Shifting — ERG target and trainer resistance from a Zwift Click (v1 verified)",
        "Strava and intervals.icu auto-upload",
        "Ride history analytics"
      ]
    })} />

    <!-- Structured Data (JSON-LD) — brand entity for search / AI answer engines -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "ENDURE",
      "url": siteUrl,
      "logo": orgLogo,
      "sameAs": [
        "https://www.instagram.com/endure_cycling_com/",
        "https://github.com/cmaart/endure-website",
        ...storeUrls
      ]
    })} />

    <!-- Structured Data (JSON-LD) — breadcrumb trail on inner pages -->
    {basePath !== '' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": lang === 'de' ? 'Startseite' : 'Home', "item": localeUrl(lang) },
          { "@type": "ListItem", "position": 2, "name": Astro.props.breadcrumb || title, "item": canonicalUrl }
        ]
      })} />
    )}
  </head>
  <body class="antialiased">
    <!--
      Nav renders on every page. `enUrl`/`deUrl` are already the current page's
      locale counterparts, so the language switch keeps you on the same page.
    -->
    <!--
      On an English-only page there is no German counterpart to switch to, so the
      DE button falls back to the German homepage rather than linking to a URL
      that does not exist.
    -->
    <Nav
      lang={lang}
      enPath={localeHref('en', basePath)}
      dePath={isTranslated ? localeHref('de', basePath) : localeHref('de')}
    />
    <slot />
    <CookieBanner lang={lang} />

    <script>
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Scroll-reveal via IntersectionObserver
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (prefersReduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => observer.observe(el));
      }

    </script>
  </body>
</html>