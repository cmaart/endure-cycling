---
// Layout for the Couchpilot pages (/couchpilot/*). Couchpilot is a separate film and series app by the same
// developer, so these pages carry none of the ENDURE chrome: no ENDURE nav, no ENDURE schema, no analytics or ad
// scripts (the Couchpilot privacy policy promises the site sets no cookies). English and German pages are separate
// routes (privacy/datenschutz, support/hilfe); `lang` picks the nav and footer labels.
import { siteUrl } from '../utils/paths';
import '@fontsource/sora/400.css';
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'de';
}

const { title, description, lang } = Astro.props;
const canonicalUrl = `${siteUrl}${Astro.url.pathname.replace(/index\.html$/, '')}`;
const labels =
  lang === 'de'
    ? {
        privacy: 'Datenschutz',
        support: 'Hilfe',
        privacyHref: '/couchpilot/datenschutz/',
        supportHref: '/couchpilot/hilfe/',
        other: 'English',
        otherHref: Astro.url.pathname.includes('hilfe') ? '/couchpilot/support/' : '/couchpilot/privacy/',
        made: 'Couchpilot, entwickelt in Österreich',
        imprint: 'Impressum',
      }
    : {
        privacy: 'Privacy',
        support: 'Support',
        privacyHref: '/couchpilot/privacy/',
        supportHref: '/couchpilot/support/',
        other: 'Deutsch',
        otherHref: Astro.url.pathname.includes('support') ? '/couchpilot/hilfe/' : '/couchpilot/datenschutz/',
        made: 'Couchpilot, developed in Austria',
        imprint: 'Imprint',
      };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Couchpilot" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      @import "../styles/global.css";
      .cp-accent { color: #b8452c; }
      .cp-accent:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <header class="border-b border-slate-200">
      <nav class="container mx-auto px-6 py-5 max-w-4xl flex flex-wrap items-center justify-between gap-4">
        <a href={labels.privacyHref} class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span class="inline-block w-3 h-3 rounded-full" style="background:#E8735A"></span>Couchpilot
        </a>
        <div class="flex gap-6 text-sm text-slate-600">
          <a href={labels.privacyHref} class="hover:text-slate-900 transition-colors">{labels.privacy}</a>
          <a href={labels.supportHref} class="hover:text-slate-900 transition-colors">{labels.support}</a>
          <a href={labels.otherHref} class="hover:text-slate-900 transition-colors" lang={lang === 'de' ? 'en' : 'de'}>{labels.other}</a>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="border-t border-slate-200">
      <div class="container mx-auto px-6 py-8 max-w-4xl flex flex-wrap gap-6 text-sm text-slate-600">
        <span>{labels.made}</span>
        <a href="mailto:info@endure-cycling.com" class="hover:text-slate-900 transition-colors">info@endure-cycling.com</a>
        <a href={labels.privacyHref} class="hover:text-slate-900 transition-colors">{labels.privacy}</a>
        <a href={lang === 'de' ? '/de/imprint/' : '/imprint/'} class="hover:text-slate-900 transition-colors">{labels.imprint}</a>
      </div>
    </footer>
  </body>
</html>
