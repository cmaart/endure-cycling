---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>ENDURE — Android Beta Teaser</title>
  </head>
  <body>
    <div class="canvas">
      <div class="glow glow-orange"></div>
      <div class="glow glow-pink"></div>

      <div class="content">
        <img
          src="/assets/ENDURE_lockup_exact_icon_4k.png"
          alt="ENDURE"
          class="logo"
        />

        <div class="eyebrow">
          <span class="dot"></span>
          NOW IN BETA
        </div>

        <h1 class="headline">
          ANDROID<br /><span class="accent">BETA</span>
        </h1>

        <p class="sub">
          Help us test ENDURE on Android.<br />
          Limited spots available.
        </p>

        <div class="cta">endure-cycling.com/android-test</div>

        <div class="dots">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>

    <style>
      :root {
        --orange: #f05d23;
        --pink: #d63c6b;
        --purple: #6b4c9a;
        --slate-900: #0f172a;
        --slate-700: #334155;
        --slate-500: #64748b;
        --bg-1: #ffffff;
        --bg-2: #f8fafc;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #e2e8f0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .canvas {
        position: relative;
        width: 1080px;
        height: 1080px;
        margin: 0 auto;
        overflow: hidden;
        background: linear-gradient(180deg, var(--bg-1) 0%, var(--bg-2) 100%);
        color: var(--slate-900);
      }

      .glow {
        position: absolute;
        border-radius: 9999px;
        filter: blur(110px);
        pointer-events: none;
      }

      .glow-orange {
        width: 620px;
        height: 620px;
        top: -160px;
        right: -180px;
        background: rgba(240, 93, 35, 0.18);
      }

      .glow-pink {
        width: 560px;
        height: 560px;
        bottom: -200px;
        left: -160px;
        background: rgba(214, 60, 107, 0.14);
      }

      .content {
        position: relative;
        z-index: 1;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 96px 80px;
        box-sizing: border-box;
        text-align: center;
      }

      .logo {
        height: 140px;
        width: auto;
        margin-bottom: 56px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 22px;
        font-weight: 600;
        letter-spacing: 0.18em;
        color: var(--slate-700);
        text-transform: uppercase;
        padding: 12px 22px;
        border-radius: 9999px;
        background: rgba(240, 93, 35, 0.08);
        border: 1px solid rgba(240, 93, 35, 0.2);
        margin-bottom: 32px;
      }

      .eyebrow .dot {
        width: 10px;
        height: 10px;
        border-radius: 9999px;
        background: var(--orange);
        box-shadow: 0 0 12px rgba(240, 93, 35, 0.6);
      }

      .headline {
        font-size: 156px;
        line-height: 0.92;
        font-weight: 800;
        letter-spacing: -0.04em;
        margin: 0 0 36px 0;
        color: var(--slate-900);
      }

      .headline .accent {
        background: linear-gradient(135deg, var(--orange) 0%, var(--pink) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .sub {
        font-size: 30px;
        line-height: 1.45;
        font-weight: 500;
        color: var(--slate-700);
        margin: 0 0 56px 0;
        max-width: 760px;
      }

      .cta {
        display: inline-flex;
        align-items: center;
        font-size: 26px;
        font-weight: 600;
        color: #ffffff;
        background: var(--orange);
        padding: 22px 44px;
        border-radius: 9999px;
        letter-spacing: -0.005em;
        box-shadow:
          0 18px 40px -12px rgba(240, 93, 35, 0.55),
          0 6px 14px -4px rgba(240, 93, 35, 0.35);
      }

      .dots {
        display: flex;
        gap: 10px;
        margin-top: 56px;
      }

      .dots span {
        width: 8px;
        height: 8px;
        border-radius: 9999px;
        background: var(--orange);
        opacity: 0.85;
      }

      .dots span:nth-child(2) {
        opacity: 0.55;
      }

      .dots span:nth-child(3) {
        opacity: 0.25;
      }
    </style>
  </body>
</html>
