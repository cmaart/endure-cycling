---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).androidTest;
const homeHref = lang === 'de' ? '/de' : '/';
---

<Layout title={t.seoTitle} description={t.seoDescription}>
  <main class="min-h-screen flex flex-col items-center justify-center px-6 py-24">
    <!-- Background decoration -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-gradient-to-br from-accent/5 to-[#d63c6b]/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 -left-32 w-96 h-96 bg-gradient-to-tr from-[#3b82f6]/5 to-[#22c55e]/5 rounded-full blur-3xl"></div>
    </div>

    <!-- Logo -->
    <a href={homeHref} class="mb-4">
      <img src="/assets/ENDURE_lockup_exact_icon_4k.png" alt="ENDURE" class="h-40 w-auto" />
    </a>

    <!-- Card -->
    <div class="w-full max-w-lg">
      <div class="card-surface p-8 md:p-10">
        <!-- Header -->
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#3DDC84] to-[#2BA963] flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.523 2.227l1.39-2.41a.29.29 0 00-.503-.29l-1.408 2.44a8.59 8.59 0 00-3.502-.734 8.59 8.59 0 00-3.502.734L8.59-.473a.29.29 0 00-.504.29l1.391 2.41C6.57 3.636 4.5 6.544 4.5 9.958h15c0-3.414-2.07-6.322-4.977-7.731zM8.5 7.458a.75.75 0 110-1.5.75.75 0 010 1.5zm7 0a.75.75 0 110-1.5.75.75 0 010 1.5zM4.5 10.958v8a1 1 0 001 1h1v3.5a1.5 1.5 0 003 0v-3.5h5v3.5a1.5 1.5 0 003 0v-3.5h1a1 1 0 001-1v-8h-15zm-3 0a1.5 1.5 0 00-1.5 1.5v5a1.5 1.5 0 003 0v-5a1.5 1.5 0 00-1.5-1.5zm21 0a1.5 1.5 0 00-1.5 1.5v5a1.5 1.5 0 003 0v-5a1.5 1.5 0 00-1.5-1.5z"/>
            </svg>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-slate-900">{t.headline}</h1>
        </div>

        <p class="text-slate-600 font-medium mb-4 leading-relaxed">{t.intro}</p>
        <p class="text-slate-500 text-sm mb-8 leading-relaxed">{t.earlyNote}</p>

        <!-- Form -->
        <form id="test-form" method="POST" class="space-y-5">
          <!-- Honeypot (spam protection) -->
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">{t.emailLabel}</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder={t.emailPlaceholder}
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-all"
            />
          </div>

          <!-- Android checkbox -->
          <label class="flex items-start gap-3 cursor-pointer group">
            <input
              type="checkbox"
              name="hasAndroid"
              value="yes"
              required
              class="mt-0.5 w-5 h-5 rounded border-slate-300 text-accent focus:ring-accent/30 cursor-pointer accent-accent"
            />
            <span class="text-slate-700 font-medium text-sm group-hover:text-slate-900 transition-colors">{t.androidCheck}</span>
          </label>

          <!-- Indoor cycling checkbox -->
          <label class="flex items-start gap-3 cursor-pointer group">
            <input
              type="checkbox"
              name="doesIndoorCycling"
              value="yes"
              class="mt-0.5 w-5 h-5 rounded border-slate-300 text-accent focus:ring-accent/30 cursor-pointer accent-accent"
            />
            <span class="text-slate-700 font-medium text-sm group-hover:text-slate-900 transition-colors">{t.indoorCheck}</span>
          </label>

          <!-- Strava checkbox -->
          <label class="flex items-start gap-3 cursor-pointer group">
            <input
              type="checkbox"
              name="usesStrava"
              value="yes"
              class="mt-0.5 w-5 h-5 rounded border-slate-300 text-accent focus:ring-accent/30 cursor-pointer accent-accent"
            />
            <span class="flex-1">
              <span class="block text-slate-700 font-medium text-sm group-hover:text-slate-900 transition-colors">{t.stravaCheck}</span>
              <span class="block text-slate-500 text-xs mt-1 leading-relaxed">{t.stravaHint}</span>
            </span>
          </label>

          <!-- Submit -->
          <button
            type="submit"
            id="submit-btn"
            class="btn-primary w-full text-center text-lg py-4 mt-2"
          >
            {t.submit}
          </button>
        </form>

        <!-- Success message (hidden) -->
        <div id="success-msg" class="hidden text-center py-4">
          <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-3">{t.successTitle}</h2>
          <p class="text-slate-600 font-medium leading-relaxed">{t.successMessage}</p>
        </div>

        <!-- Error message (hidden) -->
        <div id="error-msg" class="hidden mt-4 p-4 rounded-xl bg-red-50 border border-red-200">
          <p class="text-red-700 text-sm font-medium">
            {t.errorMessage} <a href="mailto:info@endure-cycling.com" class="underline">info@endure-cycling.com</a>
          </p>
        </div>
      </div>

      <!-- Back link -->
      <div class="text-center mt-6">
        <a href={homeHref} class="text-slate-500 font-medium text-sm hover:text-accent transition-colors">
          &larr; {t.backHome}
        </a>
      </div>
    </div>
  </main>
  <Footer />

  <script is:inline>
    const form = document.getElementById('test-form');
    const submitBtn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('success-msg');
    const errorMsg = document.getElementById('error-msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.classList.add('hidden');
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.6';
      submitBtn.textContent = submitBtn.dataset.submitting || 'Sending...';

      const data = new FormData(form);

      try {
        const res = await fetch('https://formspree.io/f/mwvazakp', {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' }
        });

        if (res.ok) {
          form.classList.add('hidden');
          successMsg.classList.remove('hidden');
        } else {
          throw new Error('Form submission failed');
        }
      } catch (err) {
        errorMsg.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.textContent = originalText;
      }
    });
  </script>
</Layout>