---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/translations';
import { localeHref } from '../../utils/paths';
import { config } from '../../config';

const lang = 'de' as const;
const t = getTranslations(lang).press;
const homeHref = localeHref('de');

const badgeSuffix = '-de';
---

<Layout lang="de" title={t.seoTitle} description={t.seoDescription}>
  <main class="container mx-auto px-6 pt-10 pb-24 max-w-4xl text-slate-800">
    <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">{t.headline}</h1>
    <p class="text-lg md:text-xl text-slate-600 font-medium leading-relaxed mb-12">{t.intro}</p>

    <div class="flex flex-wrap items-center gap-4 mb-14">
      {config.platforms.ios.available && config.platforms.ios.url && (
        <a href={config.platforms.ios.url} target="_blank" rel="noopener">
          <img src={`/assets/badges/app-store-badge${badgeSuffix}.svg`} alt="App Store" class="h-12" loading="lazy" />
        </a>
      )}
      {config.platforms.android.available && config.platforms.android.url && (
        <a href={config.platforms.android.url} target="_blank" rel="noopener">
          <img src={`/assets/badges/google-play-badge${badgeSuffix}.svg`} alt="Google Play" class="h-12" loading="lazy" />
        </a>
      )}
    </div>

    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">{t.factsTitle}</h2>
      <dl class="divide-y divide-slate-200 border-y border-slate-200">
        {t.facts.map((fact: { label: string; value: string }) => (
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4 py-3">
            <dt class="font-semibold text-slate-900">{fact.label}</dt>
            <dd class="sm:col-span-2 text-slate-700">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-3">{t.anglesTitle}</h2>
      <p class="text-lg text-slate-600 mb-6">{t.anglesIntro}</p>
      <div class="space-y-8">
        {t.angles.map((angle: { title: string; body: string }) => (
          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">{angle.title}</h3>
            <p class="text-lg leading-relaxed">{angle.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-3">{t.founderTitle}</h2>
      <p class="text-lg leading-relaxed">{t.founderBody}</p>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">{t.assetsTitle}</h2>

      <h3 class="text-xl font-bold text-slate-900 mb-3">{t.logosTitle}</h3>
      <ul class="list-disc list-inside space-y-2 mb-8">
        {t.logos.map((logo: { label: string; href: string }) => (
          <li>
            <a href={logo.href} download class="text-accent font-semibold hover:underline">{logo.label}</a>
          </li>
        ))}
      </ul>

      <h3 class="text-xl font-bold text-slate-900 mb-2">{t.screenshotsTitle}</h3>
      <p class="text-slate-600 mb-4">{t.screenshotsIntro}</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
        {t.screenshots.map((shot: { file: string; caption: string }) => (
          <figure>
            <a href={`/assets/press/${shot.file}.png`} target="_blank" rel="noopener">
              <img
                src={`/assets/press/${shot.file}.webp`}
                alt={shot.caption}
                class="rounded-xl border border-slate-200 w-full"
                loading="lazy"
              />
            </a>
            <figcaption class="text-sm text-slate-600 mt-2">
              {shot.caption}<br />
              <a href={`/assets/press/${shot.file}.png`} download class="text-accent font-semibold hover:underline">{t.downloadPng}</a>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="text-slate-600">{t.assetsNote}</p>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-3">{t.contactTitle}</h2>
      <p class="text-lg leading-relaxed">
        {t.contactBody.split('info@endure-cycling.com')[0]}<a href="mailto:info@endure-cycling.com" class="text-accent font-semibold hover:underline">info@endure-cycling.com</a>{t.contactBody.split('info@endure-cycling.com')[1]}
      </p>
    </section>

    <a href={homeHref} class="inline-flex items-center gap-2 text-accent font-semibold hover:underline">
      ← {t.backHome}
    </a>
  </main>
  <Footer />
</Layout>
