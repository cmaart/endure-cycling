---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getTranslations } from '../i18n/translations';
import { localeHref, localeUrl } from '../utils/paths';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).about;
const homeHref = localeHref(lang);

// Founder entity for E-E-A-T / AI answer engines — mirrors the "Who's behind
// ENDURE" section content.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Christoph Martin",
  "jobTitle": "Founder & Developer",
  "worksFor": { "@type": "Organization", "name": "ENDURE", "url": "https://www.endure-cycling.com" },
  "knowsAbout": ["Indoor cycling", "Cycling training", "Lactate threshold analysis", "Software development"],
  "url": localeUrl('en', '/about')
};
---

<Layout title={t.seoTitle} description={t.seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} slot="head" />
  <main class="container mx-auto px-6 pt-10 pb-24 max-w-3xl text-slate-800">
    <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">{t.headline}</h1>
    <p class="text-lg md:text-xl text-slate-600 font-medium leading-relaxed mb-12">{t.intro}</p>

    <div class="space-y-10">
      {t.sections.map((section: { title: string; body: string }) => (
        <section>
          <h2 class="text-2xl font-bold text-slate-900 mb-3">{section.title}</h2>
          <p class="text-lg leading-relaxed">{section.body}</p>
        </section>
      ))}
    </div>

    <a href={homeHref} class="inline-flex items-center gap-2 mt-14 text-accent font-semibold hover:underline">
      ← {t.backHome}
    </a>
  </main>
  <Footer />
</Layout>