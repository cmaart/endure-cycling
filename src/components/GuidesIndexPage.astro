---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { getGuidesIndex, guides, type GuideKey } from '../i18n/guides';

interface Props {
  lang: 'en' | 'de';
}

const { lang } = Astro.props;
const t = getGuidesIndex(lang);
const homeHref = lang === 'de' ? '/de' : '/';
const guideBase = lang === 'de' ? '/de/guides' : '/guides';
const entries = Object.entries(guides[lang]) as [GuideKey, (typeof guides)['en'][GuideKey]][];

// ItemList tells search engines this is a collection page and which articles it
// holds, so the hub can surface as a list rather than a single result.
const siteUrl = 'https://www.endure-cycling.com';
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t.h1,
  "itemListElement": entries.map(([slug, guide], idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": guide.h1,
    "url": `${siteUrl}${guideBase}/${slug}`
  }))
};
---

<Layout title={t.seoTitle} description={t.seoDescription} lang={lang} breadcrumb={t.h1}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} slot="head" />

  <main class="container mx-auto px-6 pt-10 pb-24 max-w-3xl text-slate-800">
    <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">{t.h1}</h1>
    <p class="text-lg md:text-xl text-slate-600 font-medium leading-relaxed mb-12">{t.intro}</p>

    <div class="space-y-6">
      {entries.map(([slug, guide]) => (
        <a href={`${guideBase}/${slug}`} class="block card-surface hover-lift p-6 group">
          <h2 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-accent transition-colors">{guide.h1}</h2>
          <p class="leading-relaxed font-medium text-slate-600 mb-3">{guide.seoDescription}</p>
          <span class="text-accent font-semibold">{t.readGuide} →</span>
        </a>
      ))}
    </div>

    <a href={homeHref} class="inline-flex items-center gap-2 mt-14 text-accent font-semibold hover:underline">
      ← {t.backHome}
    </a>
  </main>
  <Footer />
</Layout>