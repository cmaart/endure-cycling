---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getGuidesIndex, guides, type GuideKey } from '../i18n/guides';

interface Props {
  lang: 'en' | 'de';
}

const { lang } = Astro.props;
const t = getGuidesIndex(lang);
const homeHref = lang === 'de' ? '/de' : '/';
const guideBase = lang === 'de' ? '/de/guides' : '/guides';
const entries = Object.entries(guides[lang]) as [GuideKey, (typeof guides)['en'][GuideKey]][];
---

<Layout title={t.seoTitle} description={t.seoDescription} lang={lang}>
  <LanguageSwitcher />
  <main class="container mx-auto px-6 py-32 max-w-3xl text-slate-800 dark:text-gray-300">
    <a href={homeHref} class="inline-block mb-10">
      <img src="/assets/ENDURE_lockup_exact_icon_4k.png" alt="ENDURE" class="h-16 w-auto dark:hidden" />
      <img src="/assets/ENDURE_lockup_exact_icon_4k_white_transparent.min.min.webp" alt="ENDURE" class="h-16 w-auto hidden dark:block" />
    </a>

    <h1 class="text-3xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6">{t.h1}</h1>
    <p class="text-lg md:text-xl text-slate-600 dark:text-gray-400 font-medium leading-relaxed mb-12">{t.intro}</p>

    <div class="space-y-6">
      {entries.map(([slug, guide]) => (
        <a href={`${guideBase}/${slug}`} class="block card-surface hover-lift p-6 group">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-[#F05D23] transition-colors">{guide.h1}</h2>
          <p class="leading-relaxed font-medium text-slate-600 dark:text-gray-400 mb-3">{guide.seoDescription}</p>
          <span class="text-[#F05D23] font-semibold">{t.readGuide} →</span>
        </a>
      ))}
    </div>

    <a href={homeHref} class="inline-flex items-center gap-2 mt-14 text-[#F05D23] font-semibold hover:underline">
      ← {t.backHome}
    </a>
  </main>
  <Footer />
</Layout>
