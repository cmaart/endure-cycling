---
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).lactate;
---

<section id="lactate" class="relative py-20 md:py-28 overflow-hidden">
  <!-- Accent glow, bottom-left -->
  <div class="absolute -bottom-48 -left-36 w-[600px] h-[500px] pointer-events-none bg-[radial-gradient(ellipse_at_center,rgba(194,85,43,0.04),transparent_70%)]" aria-hidden="true"></div>

  <div class="page-container relative">
    <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">

      <!-- Left: copy + numbered steps -->
      <div data-reveal class="relative">
        <h2 class="mb-5 font-bold text-4xl md:text-5xl leading-[1.1] tracking-[-0.02em] text-slate-900 text-balance">
          {t.headline1}{' '}
          <span class="text-accent">{t.headline2}</span>
        </h2>

        <p class="mb-9 text-lg leading-relaxed text-slate-600 text-pretty">
          {t.description}
        </p>

        <div class="flex flex-col gap-3.5">
          {t.bullets.map((bullet: string, idx: number) => (
            <div class="flex gap-4 items-start card-surface rounded-[14px] px-5 py-4 text-[15px]">
              <span class="font-mono text-accent pt-0.5">{String(idx + 1).padStart(2, '0')}</span>
              <span class="text-slate-700" set:html={bullet}></span>
            </div>
          ))}
        </div>

        <!-- Stat highlights -->
        <div class="grid grid-cols-2 gap-3.5 mt-8">
          <div class="card-surface hover-lift p-4 text-center">
            <div class="text-xl font-bold text-accent mb-1">{t.stat1Title}</div>
            <div class="text-xs text-slate-600">{t.stat1Sub}</div>
          </div>
          <div class="card-surface hover-lift p-4 text-center">
            <div class="text-xl font-bold text-accent mb-1">{t.stat2Title}</div>
            <div class="text-xs text-slate-600">{t.stat2Sub}</div>
          </div>
        </div>

        <!-- Link into the feature landing that expands on this section -->
        <a href={localeHref(lang, '/features/lactate-lt1-lt2')} class="inline-flex items-center gap-2 mt-8 text-accent font-semibold hover:underline">
          {t.moreLink} →
        </a>
      </div>

      <!-- Right: in-app demo video in a floating phone frame -->
      <div data-reveal class="flex flex-col items-center">
        <div class="relative w-[280px] md:w-[320px] phone-frame rounded-[42px] !border-[9px]">
          <video
            loop
            muted
            playsinline
            preload="metadata"
            poster="/assets/screenshots/lactate_lt1_lt2_estimate.png"
            aria-label={lang === 'de' ? 'Laktateingabe-Demo' : 'Lactate entry demo'}
            class="w-full h-auto"
          >
            <source src="/videos/lactate_entry.mp4" type="video/mp4" />
          </video>
          <button type="button" class="lactate-toggle absolute bottom-3 right-3 grid h-11 w-11 place-items-center rounded-full border border-white/40 bg-black/70 text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" data-play={lang === 'de' ? 'Video abspielen' : 'Play video'} data-pause={lang === 'de' ? 'Video pausieren' : 'Pause video'} aria-label={lang === 'de' ? 'Video abspielen' : 'Play video'}>
            <svg class="lactate-play h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" /></svg>
            <svg class="lactate-pause hidden h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1" /><rect x="9.5" y="2" width="3.5" height="12" rx="1" /></svg>
          </button>
        </div>
        <p class="text-center text-slate-500 text-sm mt-4">
          {t.videoCaption}
        </p>
      </div>
    </div>

    <!-- Result screenshot -->
    <div class="mt-16 flex flex-col items-center" data-reveal>
      <p class="text-sm font-semibold text-slate-700 mb-5 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
        {t.resultLabel}
      </p>
      <div class="max-w-xs w-full">
        <div class="phone-frame rounded-[32px]">
          <img
            src="/assets/screenshots/lactate_lt1_lt2_estimate.png"
            alt="ENDURE Lactate Profile with LT1 and LT2 estimates"
            width="1080"
            height="2253"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </div>
        <p class="text-center text-slate-500 text-sm mt-4">
          {t.resultCaption}
        </p>
      </div>
    </div>
  </div>
</section>
<script>
  const video = document.querySelector<HTMLVideoElement>('#lactate video');
  const button = document.querySelector<HTMLButtonElement>('#lactate .lactate-toggle');
  if (video && button) {
    const update = () => {
      button.setAttribute('aria-label', (video.paused ? button.dataset.play : button.dataset.pause) ?? '');
      button.querySelector('.lactate-play')?.classList.toggle('hidden', !video.paused);
      button.querySelector('.lactate-pause')?.classList.toggle('hidden', video.paused);
    };
    video.addEventListener('play', update);
    video.addEventListener('pause', update);
    button.addEventListener('click', () => { if (video.paused) void video.play().catch(update); else video.pause(); });
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) void video.play().catch(update);
  }
</script>
