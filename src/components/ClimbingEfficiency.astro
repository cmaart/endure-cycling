---
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).climbingEfficiency;
---

<section id="climbing-efficiency" class="py-16 relative overflow-hidden">
  <!-- Subtle background gradient -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-br from-emerald-100/30 dark:from-emerald-900/20 via-teal-50/20 dark:via-teal-900/10 to-slate-100/10 dark:to-transparent rounded-full blur-3xl"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-5xl mx-auto">
    <!-- Section badge -->
    <div class="flex justify-center mb-6">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-700/50 text-emerald-700 dark:text-emerald-400 text-sm font-semibold tracking-wide uppercase">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
        </svg>
        {t.badge}
      </span>
    </div>

    <!-- Two-column layout: text left, image right -->
    <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16">

      <!-- Left: Text content -->
      <div class="flex-1 text-center lg:text-left">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 leading-tight text-slate-900 dark:text-white">
          {t.headline1}<br/>
          <span class="text-gradient-primary">{t.headline2}</span>
        </h2>

        <p class="text-base md:text-lg text-slate-600 dark:text-gray-400 font-medium leading-relaxed mb-6">
          {t.description}
        </p>

        <!-- Stat highlights -->
        <div class="grid grid-cols-2 gap-3 mb-6">
          <div class="bg-white/80 dark:bg-[#1a1c22]/80 backdrop-blur-sm border border-slate-200 dark:border-white/10 rounded-xl p-3 shadow-sm text-center hover:shadow-md transition-shadow">
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mb-1">VAM</div>
            <div class="text-xs text-slate-600 dark:text-gray-400 font-medium">{t.stat1}</div>
          </div>
          <div class="bg-white/80 dark:bg-[#1a1c22]/80 backdrop-blur-sm border border-slate-200 dark:border-white/10 rounded-xl p-3 shadow-sm text-center hover:shadow-md transition-shadow">
            <div class="text-xl font-bold text-[#F05D23] mb-1">#1</div>
            <div class="text-xs text-slate-600 dark:text-gray-400 font-medium">{t.stat2}</div>
          </div>
        </div>

        <!-- Bullet points -->
        <ul class="space-y-3 text-left">
          {t.bullets.map((bullet: string) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/40 border border-emerald-300 dark:border-emerald-700/50 flex items-center justify-center">
                <svg class="w-3 h-3 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="text-slate-600 dark:text-gray-400 font-medium" set:html={bullet}></span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: Marketing screenshot -->
      <div class="flex-1 w-full max-w-lg mx-auto lg:mx-0">
        <div class="relative group">
          <!-- Glow effect -->
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-200/40 dark:from-emerald-800/20 to-teal-200/30 dark:to-teal-800/10 rounded-3xl blur-2xl group-hover:blur-3xl transition-all scale-95"></div>
          <img
            src="/assets/climbing_efficiency_feature.webp"
            alt="Climbing Efficiency feature in ENDURE app"
            class="relative w-full h-auto rounded-3xl shadow-2xl shadow-slate-300/50 dark:shadow-black/30 border border-white/60 dark:border-white/10 group-hover:shadow-slate-400/40 dark:group-hover:shadow-black/50 transition-all"
          />
        </div>
      </div>

    </div>
    </div>
  </div>
</section>
