---
/**
 * Homepage AI coach section, first section after the hero (2026-10-29).
 * Replaces the training planning teaser and the daily guidance section:
 * training planning leads in three steps (Week planner, Plan with coach,
 * every session explained), daily guidance is a callout in the last step.
 * Design handoff: docs/design/home-coach-section/.
 */
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';
import { webAppImage } from '../webAppImages';
import BetaTag from './BetaTag.astro';
import WebAppLink from './WebAppLink.astro';

const lang = (Astro.currentLocale as 'en' | 'de') || 'en';
const t = getTranslations(lang).coach;
const [weekPlanner, planWithCoach, session] = t.steps;
const weekPlannerImg = webAppImage(lang, 'weekPlanner');
const planWithCoachImg = webAppImage(lang, 'planWithCoach');
const sessionImg = webAppImage(lang, 'sessionAlternatives');

const stepNumber = 'font-mono text-[13px] tracking-[0.04em] text-accent mb-3 md:mb-4';
const stepTitle = 'text-2xl md:text-3xl font-extrabold tracking-[-0.02em] leading-tight text-slate-900 mb-3 md:mb-4';
const stepBody = 'text-base md:text-lg leading-relaxed text-slate-600';
const imageButton = 'group relative block w-full rounded-2xl border border-slate-200 bg-white overflow-hidden cursor-zoom-in shadow-[0_30px_80px_-24px_rgba(22,24,29,0.18)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent';
const chip = 'absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded-full bg-slate-900/80 text-endure-bg-primary px-3 py-1.5 font-mono text-xs md:opacity-0 md:group-hover:opacity-100 md:group-focus-visible:opacity-100 transition-opacity';
---

<section id="coach" class="py-20 md:py-28">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">

      <header data-reveal class="flex flex-col lg:flex-row lg:items-end gap-5 lg:gap-16">
        <div class="lg:basis-7/12">
          <div class="flex items-center gap-3 font-mono text-[13px] tracking-[0.04em] text-accent mb-5 md:mb-6">
            <span class="inline-block w-10 h-px bg-accent" aria-hidden="true"></span>
            {t.eyebrow}
          </div>
          <h2 class="text-4xl md:text-6xl font-extrabold tracking-[-0.03em] leading-[1.05] text-slate-900 text-balance">
            {t.headline}
          </h2>
        </div>
        <p class="lg:basis-5/12 text-base md:text-lg text-slate-600 leading-relaxed max-w-2xl">{t.intro}</p>
      </header>

      <ol class="mt-12 md:mt-[72px]">

        <!-- 01 Week planner: text | image -->
        <li class="py-12 md:py-16 border-t border-slate-100 flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-16">
          <div data-reveal class="lg:basis-5/12 max-w-2xl">
            <div class={stepNumber}>01</div>
            <h3 class={stepTitle}>{weekPlanner.title}<BetaTag /></h3>
            <p class={stepBody}>{weekPlanner.body}</p>
          </div>
          <div data-reveal data-reveal-delay="100" class="lg:basis-7/12 min-w-0">
            <button type="button" class:list={[imageButton, 'max-w-[480px] mx-auto']} data-lightbox-src={weekPlannerImg.src} data-lightbox-alt={weekPlanner.imageAlt}>
              <img src={weekPlannerImg.src} alt={weekPlanner.imageAlt} width={weekPlannerImg.width} height={weekPlannerImg.height} loading="lazy" decoding="async" class="block w-full h-auto" />
              <span aria-hidden="true" class={chip}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.35-4.35M11 8v6M8 11h6"></path></svg>
                {t.enlarge}
              </span>
            </button>
          </div>
        </li>

        <!-- 02 Plan with coach: header row, then the full-width image (draft panel crop below md) -->
        <li class="py-12 md:py-16 border-t border-slate-100">
          <div data-reveal class="flex flex-col lg:flex-row lg:items-end gap-x-16">
            <div class="lg:basis-5/12">
              <div class={stepNumber}>02</div>
              <h3 class:list={[stepTitle, 'lg:mb-0']}>{planWithCoach.title}<BetaTag /></h3>
            </div>
            <p class:list={[stepBody, 'lg:basis-7/12 max-w-2xl']}>{planWithCoach.body}</p>
          </div>
          <figure data-reveal data-reveal-delay="100" class="mt-8 md:mt-10">
            <button type="button" class:list={[imageButton, 'aspect-[580/1289] md:aspect-auto md:rounded-[20px]']} data-lightbox-src={planWithCoachImg.src} data-lightbox-alt={planWithCoach.imageAlt}>
              <img src={planWithCoachImg.src} alt={planWithCoach.imageAlt} width={planWithCoachImg.width} height={planWithCoachImg.height} loading="lazy" decoding="async" class="block w-full h-full object-cover object-right-top md:h-auto" />
              <span aria-hidden="true" class={chip}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.35-4.35M11 8v6M8 11h6"></path></svg>
                {t.enlarge}
              </span>
            </button>
            <figcaption class="mt-3 text-sm text-slate-600 md:hidden">{t.cropNote}</figcaption>
          </figure>
        </li>

        <!-- 03 Every session explained: image | text + daily guidance callout -->
        <li class="py-12 md:py-16 border-t border-slate-100 flex flex-col lg:flex-row-reverse lg:items-center gap-8 lg:gap-16">
          <div data-reveal class="lg:basis-5/12 max-w-2xl">
            <div class={stepNumber}>03</div>
            <h3 class={stepTitle}>{session.title}</h3>
            <p class={stepBody}>{session.body}</p>
            <div class="mt-6 md:mt-7 bg-white border border-slate-200 rounded-2xl p-5 md:px-6">
              <div class="flex items-center gap-2.5 font-mono text-[13px] tracking-[0.04em] text-accent mb-2.5">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
                {t.daily.label}
              </div>
              <p class="text-[15px] md:text-base leading-relaxed text-slate-600">{t.daily.body}</p>
            </div>
          </div>
          <div data-reveal data-reveal-delay="100" class="lg:basis-7/12 min-w-0">
            <button type="button" class:list={[imageButton, 'max-w-[600px] lg:max-w-[620px] mx-auto']} data-lightbox-src={sessionImg.src} data-lightbox-alt={session.imageAlt}>
              <img src={sessionImg.src} alt={session.imageAlt} width={sessionImg.width} height={sessionImg.height} loading="lazy" decoding="async" class="block w-full h-auto" />
              <span aria-hidden="true" class={chip}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.35-4.35M11 8v6M8 11h6"></path></svg>
                {t.enlarge}
              </span>
            </button>
          </div>
        </li>

      </ol>

      <div data-reveal class="pt-10 md:pt-12 border-t border-slate-100 flex flex-col items-stretch sm:flex-row sm:flex-wrap sm:items-center gap-x-8 gap-y-2">
        <a href={localeHref(lang, '/features/training-planning')} class="btn-secondary justify-center">{t.link} <span aria-hidden="true">→</span></a>
        <a href={localeHref(lang, '/features/ai-coach')} class="inline-flex items-center min-h-11 text-accent-hover font-semibold hover:underline">{t.coachLink} →</a>
        <WebAppLink lang={lang} placement="home-coach" label={t.webLink} />
      </div>

    </div>
  </div>
</section>

<script>
  // Screenshots open full size in the shared Lightbox (same pattern as TrainingPlanningPage).
  document.querySelectorAll<HTMLElement>('#coach [data-lightbox-src]').forEach((el) => {
    el.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('lightbox:open', {
        detail: { src: el.dataset.lightboxSrc, alt: el.dataset.lightboxAlt },
      }));
    });
  });
</script>
