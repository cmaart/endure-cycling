---
/**
 * Homepage AI coach section, first section after the hero (2026-10-29).
 * Since 2026-11-10 six pinned steps (prototype "C"): Week planner, Plan with
 * coach, every session explained (daily guidance), ride it in the app (with
 * the coach's ride review). From lg the section holds on screen while the
 * steps open in turn and the frame at the right changes to each step's phone
 * screenshot, with a card popping out of it. Below lg, and under reduced
 * motion, each step stands with its screenshot under it.
 * Screenshots: public/assets/coach/<lang>/, from the app repo
 * (distribution/screenshots), converted to 720 px WebP.
 */
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';
import BetaTag from './BetaTag.astro';
import WebAppLink from './WebAppLink.astro';

const lang = (Astro.currentLocale as 'en' | 'de') || 'en';
const t = getTranslations(lang).coach;
const dir = `/assets/coach/${lang}`;

// Per step: the phone screenshot, its pixel size and the card beside it.
const shots = [
  { phone: 'week-planner.webp', h: 1600, card: { img: 'card-week.webp', w: 800, h: lang === 'de' ? 494 : 496 }, beta: true },
  { phone: 'plan-change.webp', h: 1600, card: { img: 'card-change.webp', w: 800, h: 917, narrow: true }, beta: true },
  { phone: 'today.webp', h: 1600, quote: 'today' as const },
  { phone: 'ride.webp', h: 1575 },
  { phone: 'activity_detail.webp', h: 2364, app: true, quote: 'review' as const },
  { phone: 'vo2max_detail.webp', h: 2364, app: true, progress: true },
];
const steps = t.steps.map((step, i) => ({ ...step, ...shots[i] }));
---

<section id="coach" class="coach py-20 md:py-28">
  <div class="page-container">

    <header data-reveal class="flex flex-col lg:flex-row lg:items-end gap-5 lg:gap-16">
      <div class="lg:basis-7/12">
        <h2 class="text-4xl md:text-6xl font-extrabold tracking-[-0.04em] leading-[1.02] text-slate-900 text-balance">
          {t.headline}
        </h2>
      </div>
      <p class="lg:basis-5/12 text-base md:text-lg text-slate-600 leading-relaxed max-w-2xl">{t.intro}</p>
    </header>

    <div class="coach-pin" style={`--n:${steps.length}`}>
      <div class="coach-chap">
        <ol class="coach-steps">
          {steps.map((step, i) => (
            <li class="coach-step" data-step={i}>
              <h3 class="coach-step-title">
                <button type="button" class="coach-step-control" disabled><span class="coach-step-n">0{i + 1}</span><span>{step.title}{step.beta && <BetaTag />}</span></button>
              </h3>
              <div class="coach-step-body">
                <p>{step.body}</p>
                <div class="coach-bar" aria-hidden="true"><i></i></div>
              </div>
              <!-- Stacked layout (below lg, reduced motion): the screenshot under its step. -->
              <button type="button" class="coach-mobile-shot" data-lightbox-src={`${step.app ? `/assets/app/${lang}` : dir}/${step.phone}`} data-lightbox-alt={step.imageAlt} aria-label={t.enlarge.replace('{name}', step.title)}>
                <img src={`${step.app ? `/assets/app/${lang}` : dir}/${step.phone}`} alt="" width="720" height={step.h} loading="lazy" decoding="async" />
              </button>
              {step.progress && <button type="button" class="coach-mobile-shot" data-lightbox-src={`/assets/app/${lang}/ftp_detail.webp`} data-lightbox-alt={lang === 'de' ? 'FTP-Schätzung mit Verlauf und relevanten Fahrten' : 'FTP estimate with trend and contributing rides'} aria-label={lang === 'de' ? 'FTP-Ansicht vergrößern' : 'Enlarge FTP estimate'}>
                <img src={`/assets/app/${lang}/ftp_detail.webp`} alt="" width="720" height="1600" loading="lazy" decoding="async" />
              </button>}
            </li>
          ))}
        </ol>

        <!-- Pinned layout: one frame, one composition per step. -->
        <div class="coach-frame">
          {steps.map((step, i) => (
            <div class="coach-comp" data-comp={i}>
              <button type="button" class="coach-phone" data-lightbox-src={`${step.app ? `/assets/app/${lang}` : dir}/${step.phone}`} data-lightbox-alt={step.imageAlt} aria-label={t.enlarge.replace('{name}', step.title)} tabindex="-1">
                <img src={`${step.app ? `/assets/app/${lang}` : dir}/${step.phone}`} alt={step.imageAlt} width="720" height={step.h} loading="lazy" decoding="async" />
              </button>
              {step.progress && <button type="button" class="coach-progress-shot" data-lightbox-src={`/assets/app/${lang}/ftp_detail.webp`} data-lightbox-alt={lang === 'de' ? 'FTP-Schätzung mit Verlauf und relevanten Fahrten' : 'FTP estimate with trend and contributing rides'} aria-label={lang === 'de' ? 'FTP-Ansicht vergrößern' : 'Enlarge FTP estimate'} tabindex="-1">
                <img src={`/assets/app/${lang}/ftp_detail.webp`} alt="" width="720" height="1600" loading="lazy" decoding="async" />
              </button>}
              <div class:list={['coach-card', step.card?.narrow && 'coach-card--narrow']} aria-hidden="true">
                {step.card && (
                  <img src={`${dir}/${step.card.img}`} alt="" width={step.card.w} height={step.card.h} loading="lazy" decoding="async" />
                )}
                {step.quote === 'today' && (
                  <div class="coach-quote">
                    <small>{t.cards.today.label}</small>
                    <p>{t.cards.today.text}</p>
                    <span class="coach-quote-pill">● {t.cards.today.tag}</span>
                  </div>
                )}
                {step.quote === 'review' && (
                  <div class="coach-quote">
                    <small>{t.cards.review.label}</small>
                    <p>{t.cards.review.text}</p>
                    <div class="coach-quote-tags">{t.cards.review.tags.map((tag) => <span>{tag}</span>)}</div>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div data-reveal class="pt-10 md:pt-12 border-t border-slate-100 flex flex-col items-stretch sm:flex-row sm:flex-wrap sm:items-center gap-x-8 gap-y-2">
      <a href={localeHref(lang, '/features/training-planning')} class="btn-secondary justify-center">{t.link} <span aria-hidden="true">→</span></a>
      <a href={localeHref(lang, '/features/ai-coach')} class="inline-flex items-center min-h-11 text-accent-hover font-semibold hover:underline">{t.coachLink} →</a>
      <WebAppLink lang={lang} placement="home-coach" label={t.webLink} />
    </div>

  </div>
</section>

<style>
  /* ---------- Stacked layout (default) ---------- */
  .coach-pin { margin-top: 48px; }
  .coach-steps { list-style: none; margin: 0; padding: 0; }
  .coach-step {
    padding: 32px 0;
    border-top: 1px solid var(--color-slate-200);
  }
  .coach-step-title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 26px;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-slate-900);
  }
  .coach-step-control { display: flex; align-items: baseline; gap: 14px; text-align: left; font: inherit; color: inherit; }
  .coach-step-control:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .coach-step-n {
    flex: none;
    font: 800 15px var(--font-sans);
    color: var(--color-accent);
  }
  .coach-step-body p {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-slate-600);
    max-width: 36rem;
  }
  .coach-bar { display: none; }
  .coach-mobile-shot {
    display: block;
    width: 100%;
    margin-top: 22px;
    padding: 24px 0;
    border-radius: 16px;
    background: #17181a;
    cursor: zoom-in;
  }
  .coach-mobile-shot img {
    width: min(62%, 280px);
    margin-inline: auto;
    border-radius: 26px;
    border: 7px solid #0b0b0c;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .coach-frame { display: none; }

  /* ---------- Pinned layout (lg, motion allowed) ---------- */
  @media (min-width: 1024px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .coach-pin {
      height: calc(var(--n) * 50vh + 50vh);
      margin-top: 24px;
    }
    .coach-chap {
      position: sticky;
      top: 0;
      height: 100vh;
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: center;
    }
    .coach-step { padding: 14px 0; transition: border-color 0.35s; }
    .coach-step-title { font-size: 26px; color: var(--color-slate-500); transition: color 0.35s; }
    .coach-step-control { display: flex; align-items: baseline; gap: 14px; text-align: left; font: inherit; color: inherit; }
  .coach-step-control:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .coach-step-n { opacity: 0.6; transition: opacity 0.35s; }
    .coach-step-body {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .coach-step-body > * { overflow: hidden; }
    .coach-step-body p { margin-top: 0; padding-top: 12px; }
    .coach-bar {
      display: block;
      height: 2px;
      margin-top: 18px;
      border-radius: 2px;
      background: var(--color-slate-200);
    }
    .coach-bar i { display: block; height: 100%; width: 0; background: var(--color-accent); }
    .coach-step.on { border-color: var(--color-slate-900); }
    .coach-step.on .coach-step-title { color: var(--color-slate-900); }
    .coach-step.on .coach-step-n { opacity: 1; }
    .coach-step.on .coach-step-body { grid-template-rows: 1fr; }
    .coach-mobile-shot { display: none; }

    .coach-frame {
      display: block;
      position: relative;
      aspect-ratio: 1 / 1;
      max-height: 84vh;
      width: 100%;
      margin-inline: auto;
      border-radius: 20px;
      overflow: hidden;
      background: #17181a;
    }
    .coach-frame::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(60% 50% at 40% 45%, rgb(194 85 43 / 0.28), transparent 70%);
    }
    .coach-comp {
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.5s ease, visibility 0s linear 0.5s;
    }
    .coach-comp.on { opacity: 1; visibility: visible; transition: opacity 0.5s ease; }
    .coach-phone {
      position: absolute;
      left: 14%;
      top: 7%;
      height: 86%;
      aspect-ratio: 9 / 20;
      padding: 8px;
      border-radius: 36px;
      background: #0b0b0c;
      box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08), 0 40px 80px -30px #000;
      overflow: hidden;
      cursor: zoom-in;
      transform: translateY(16px);
      transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .coach-phone img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      border-radius: 28px;
    }
    .coach-progress-shot {
      position: absolute;
      right: 8%;
      top: 15%;
      height: 72%;
      aspect-ratio: 9 / 20;
      padding: 7px;
      border-radius: 30px;
      background: #0b0b0c;
      overflow: hidden;
      cursor: zoom-in;
      box-shadow: 0 30px 60px -25px #000;
    }
    .coach-progress-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 23px; }
    .coach-progress-shot:focus-visible { outline: 2px solid white; outline-offset: -4px; }
    .coach-card {
      position: absolute;
      right: 5%;
      bottom: 10%;
      width: 52%;
      opacity: 0;
      transform: translateX(28px) scale(0.97);
      transition: opacity 0.5s ease 0.25s, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.25s;
      filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.45));
    }
    .coach-card--narrow { width: 42%; }
    .coach-card img { width: 100%; border-radius: 22px; }
    .coach-comp.on .coach-phone { transform: none; }
    .coach-comp.on .coach-card { opacity: 1; transform: none; }
  }

  /* App-styled quote card (steps 3 and 4), in the app's own system font */
  .coach-quote {
    background: #fff;
    border-radius: 22px;
    padding: 22px 24px;
    font-family: Roboto, system-ui, -apple-system, sans-serif;
    color: #1d2230;
  }
  .coach-quote small {
    display: block;
    margin-bottom: 10px;
    font: 500 11px var(--font-mono);
    letter-spacing: 0.14em;
    color: #6b7280;
  }
  .coach-quote p { font-size: 17px; line-height: 1.45; }
  .coach-quote-pill {
    display: inline-block;
    margin-top: 12px;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: #b07800;
    background: #fff4d6;
  }
  .coach-quote-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .coach-quote-tags span {
    padding: 6px 10px;
    border-radius: 10px;
    border: 1px solid #c9d8e3;
    background: #eef3f7;
    font-size: 13px;
    font-weight: 600;
    color: #4a6b85;
  }
</style>

<script>
  // Screenshots open full size in the shared Lightbox.
  document.querySelectorAll<HTMLElement>('#coach [data-lightbox-src]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      document.dispatchEvent(new CustomEvent('lightbox:open', {
        detail: { src: el.dataset.lightboxSrc, alt: el.dataset.lightboxAlt },
      }));
    });
  });

  // Pinned chapters: the step whose share of the pinned scroll is current opens,
  // its bar fills with the scroll, the frame shows its composition.
  const pin = document.querySelector<HTMLElement>('#coach .coach-pin');
  if (pin) {
    const steps = Array.from(pin.querySelectorAll<HTMLElement>('.coach-step'));
    const comps = Array.from(pin.querySelectorAll<HTMLElement>('.coach-comp'));
    const pinned = window.matchMedia('(min-width: 1024px) and (min-height: 700px) and (prefers-reduced-motion: no-preference)');
    let current = -1;

    const show = (i: number) => {
      if (i === current) return;
      current = i;
      steps.forEach((s, k) => { s.classList.toggle('on', k === i); s.querySelector('.coach-step-control')?.setAttribute('aria-current', k === i ? 'step' : 'false'); });
      comps.forEach((c, k) => {
        c.classList.toggle('on', k === i);
        c.querySelectorAll('button').forEach((button) => button.setAttribute('tabindex', k === i ? '0' : '-1'));
      });
    };

    const tick = () => {
      if (!pinned.matches) return;
      const r = pin.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / span));
      const f = p * steps.length;
      const i = Math.min(steps.length - 1, Math.floor(f));
      show(i);
      steps.forEach((s, k) => {
        const bar = s.querySelector<HTMLElement>('.coach-bar i');
        if (bar) bar.style.width = `${k < i ? 100 : k === i ? Math.min(100, (f - i) * 100) : 0}%`;
      });
    };

    // A click on a closed step scrolls to its share of the pinned range.
    const updateControls = () => steps.forEach((s) => { const button = s.querySelector<HTMLButtonElement>('.coach-step-control'); if (button) button.disabled = !pinned.matches; });
    steps.forEach((s, k) => s.querySelector('.coach-step-control')?.addEventListener('click', () => {
      if (!pinned.matches) return;
      const top = pin.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top: top + (pin.offsetHeight - window.innerHeight) * (k + 0.1) / steps.length, behavior: 'smooth' });
    }));

    show(0);
    window.addEventListener('scroll', tick, { passive: true });
    window.addEventListener('resize', tick);
    pinned.addEventListener('change', () => { updateControls(); tick(); });
    updateControls();
    tick();
  }
</script>
