---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { getTranslations } from '../i18n/translations';
import { getFeatureContent, type FeatureKey } from '../i18n/features';
import { config } from '../config';
import StoreBadges from './StoreBadges.astro';
import BetaTag from './BetaTag.astro';
import { localeHref, localeUrl } from '../utils/paths';
import { featureFaqSchema, featureWebPageSchema } from '../utils/featureSchema';
import ArticleHero from './ArticleHero.astro';
import ArticleAside from './ArticleAside.astro';
import ArticleSection from './ArticleSection.astro';
import { sectionId } from '../i18n/article';

interface Props {
  lang: 'en' | 'de';
  feature: FeatureKey;
}

const { lang, feature } = Astro.props;
const t = getFeatureContent(lang, feature);
const tr = getTranslations(lang);
const homeHref = localeHref(lang);
const canonicalUrl = localeUrl(lang, `/features/${feature}`);

const pageSchema = featureWebPageSchema(t, canonicalUrl, lang);
const faqSchema = featureFaqSchema(t.faq);
---

<Layout title={t.seoTitle} description={t.seoDescription} lang={lang} breadcrumb={t.breadcrumb}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <!--
    Two layouts share this markup. An entry with `hero` gets the picture hero
    and the sticky download rail; every other entry keeps the single column.
  -->
  <main class:list={['pb-24 text-slate-800', !t.hero && 'container mx-auto px-6 pt-10 max-w-3xl']}>
    {t.hero && (
      <ArticleHero lang={lang} title={t.h1} subtitle={t.subtitle} beta={t.beta} image={t.hero} placement="feature_hero" />
    )}
    <div class:list={[t.hero && 'page-container mt-12 grid gap-x-16 lg:mt-16 lg:grid-cols-[minmax(0,1fr)_18rem]']}>
    <div class:list={[t.hero && 'max-w-3xl']}>
    <article>
      {!t.hero && (
        <Fragment>
          <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-3 leading-tight">{t.h1}{t.beta && <BetaTag />}</h1>
          <p class="text-xl md:text-2xl text-slate-600 font-semibold mb-8">{t.subtitle}</p>
        </Fragment>
      )}

      <!-- Direct answer (featured-snippet target) -->
      <p class="text-lg leading-relaxed font-medium bg-accent/[0.06] rounded-2xl px-6 py-5 mb-12">
        {t.directAnswer}
      </p>

      <div class="space-y-12">
        {t.sections.map((section, i) => (
          <ArticleSection
            id={sectionId(i)}
            title={section.title}
            body={section.body}
            bullets={section.bullets}
            ordered={section.ordered}
          />
        ))}
      </div>

      <!-- FAQ -->
      <section class="mt-14 space-y-6">
        {t.faq.map((item) => (
          <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
            <h2 class="text-lg font-bold text-slate-900 mb-2">{item.q}</h2>
            <p class="leading-relaxed font-medium text-slate-600">{item.a}</p>
          </div>
        ))}
      </section>

      <!-- CTA -->
      <section class="text-center card-surface p-8 mt-14 mb-10">
        <h2 class="text-2xl font-bold text-slate-900 mb-3">{t.ctaTitle}</h2>
        <p class="text-lg leading-relaxed mb-6">{t.ctaBody}</p>
        <div data-placement="feature_cta" class="flex flex-wrap justify-center items-center gap-4">
          <StoreBadges lang={lang} lazy />
        </div>
      </section>
    </article>

    <!-- Related pages: keeps the new landings linked to each other and to the guides -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-slate-900 mb-4">{t.relatedTitle}</h2>
      <ul class="space-y-2">
        {t.related.map((link) => (
          <li>
            <a href={localeHref(lang, link.href)} class="text-accent font-semibold hover:underline">
              {link.label} →
            </a>
          </li>
        ))}
      </ul>
    </section>

    <a href={homeHref} class="inline-flex items-center gap-2 text-accent font-semibold hover:underline">
      ← {t.backHome}
    </a>
    </div>
    {t.hero && (
      <ArticleAside lang={lang} sections={t.sections.map((section) => section.title)} title={t.ctaTitle} placement="feature_rail" />
    )}
    </div>
  </main>
  <Footer />
</Layout>
