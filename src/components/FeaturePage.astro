---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { getTranslations } from '../i18n/translations';
import { getFeatureContent, type FeatureKey } from '../i18n/features';
import { config } from '../config';

interface Props {
  lang: 'en' | 'de';
  feature: FeatureKey;
}

const { lang, feature } = Astro.props;
const t = getFeatureContent(lang, feature);
const tr = getTranslations(lang);
const prefix = lang === 'de' ? '/de' : '';
const homeHref = lang === 'de' ? '/de' : '/';
const appStoreBadge = lang === 'de' ? '/assets/badges/app-store-badge-de.svg' : '/assets/badges/app-store-badge.svg';
const googlePlayBadge = lang === 'de' ? '/assets/badges/google-play-badge-de.svg' : '/assets/badges/google-play-badge.svg';

// FAQPage covers the question-phrased sections; the direct answer above them is
// the featured-snippet target.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faq.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
};
---

<Layout title={t.seoTitle} description={t.seoDescription} lang={lang} breadcrumb={t.breadcrumb}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <main class="container mx-auto px-6 pt-10 pb-24 max-w-3xl text-slate-800">
    <article>
      <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-3 leading-tight">{t.h1}</h1>
      <p class="text-xl md:text-2xl text-slate-600 font-semibold mb-8">{t.subtitle}</p>

      <!-- Direct answer (featured-snippet target) -->
      <p class="text-lg leading-relaxed font-medium bg-slate-50 border-l-4 border-accent rounded-r-xl px-6 py-5 mb-12">
        {t.directAnswer}
      </p>

      <div class="space-y-12">
        {t.sections.map((section) => (
          <section>
            <h2 class="text-2xl font-bold text-slate-900 mb-3">{section.title}</h2>
            <p class="text-lg leading-relaxed">{section.body}</p>
            {section.bullets && (
              <ul class="mt-4 space-y-3">
                {section.bullets.map((bullet) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1.5 flex-shrink-0 w-5 h-5 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center">
                      <svg class="w-3 h-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                      </svg>
                    </span>
                    <span class="text-lg leading-relaxed font-medium" set:html={bullet} />
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>

      <!-- FAQ -->
      <section class="mt-14 space-y-6">
        {t.faq.map((item) => (
          <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
            <h2 class="text-lg font-bold text-slate-900 mb-2">{item.q}</h2>
            <p class="leading-relaxed font-medium text-slate-600">{item.a}</p>
          </div>
        ))}
      </section>

      <!-- CTA -->
      <section class="text-center card-surface p-8 mt-14 mb-10">
        <h2 class="text-2xl font-bold text-slate-900 mb-3">{t.ctaTitle}</h2>
        <p class="text-lg leading-relaxed mb-6">{t.ctaBody}</p>
        <div class="flex flex-wrap justify-center items-center gap-4">
          {config.platforms.ios.available && config.platforms.ios.url && (
            <a href={config.platforms.ios.url} target="_blank" rel="noopener" aria-label={tr.hero.appStoreBadgeAlt}>
              <img src={appStoreBadge} alt={tr.hero.appStoreBadgeAlt} class="h-12 w-auto" />
            </a>
          )}
          {config.platforms.android.available && config.platforms.android.url && (
            <a href={config.platforms.android.url} target="_blank" rel="noopener" aria-label={tr.hero.googlePlayBadgeAlt}>
              <img src={googlePlayBadge} alt={tr.hero.googlePlayBadgeAlt} class="h-12 w-auto" />
            </a>
          )}
        </div>
      </section>
    </article>

    <!-- Related pages: keeps the new landings linked to each other and to the guides -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-slate-900 mb-4">{t.relatedTitle}</h2>
      <ul class="space-y-2">
        {t.related.map((link) => (
          <li>
            <a href={`${prefix}${link.href}`} class="text-accent font-semibold hover:underline">
              {link.label} →
            </a>
          </li>
        ))}
      </ul>
    </section>

    <a href={homeHref} class="inline-flex items-center gap-2 text-accent font-semibold hover:underline">
      ← {t.backHome}
    </a>
  </main>
  <Footer />
</Layout>
