---
import { getTranslations } from '../i18n/translations';
import { config } from '../config';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).roadmap;
const isAvailable = config.isProductAvailable;
---

<section id="roadmap" class="py-24 relative">
  <!-- Background decoration -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-slate-100/50 rounded-full blur-3xl"></div>
  </div>
  
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-slate-900">
          {t.title} <span class="text-gradient-primary">{t.titleHighlight}</span>
        </h2>
        <p class="text-slate-600 font-medium text-lg">
          {t.subtitle}
        </p>
      </div>
      
      <!-- Devices Image -->
      <div class="mb-16">
        <img 
          src="/assets/marketing/Devies_withbackground.min.webp" 
          alt="Endure on multiple devices" 
          class="lg:w-5/6 w-full mx-auto rounded-2xl shadow-xl shadow-slate-200 border border-slate-200"
        />
      </div>

      <!-- Platform Status Grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <!-- Windows -->
        {isAvailable ? (
          <div class="card-surface p-6 text-center border-green-500/30 bg-green-50/50">
            <div class="text-4xl mb-3">✅</div>
            <h3 class="font-bold text-slate-900 text-lg mb-1">{t.windows}</h3>
            <span class="inline-block px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-bold">
              {t.windowsStatus}
            </span>
          </div>
        ) : (
          <div class="card-surface p-6 text-center">
            <div class="text-4xl mb-3">🚧</div>
            <h3 class="font-bold text-slate-900 text-lg mb-1">{t.windows}</h3>
            <span class="inline-block px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-sm font-bold">
              {t.windowsStatus}
            </span>
          </div>
        )}
        
        <!-- Android -->
        <div class="card-surface p-6 text-center">
          <div class="text-4xl mb-3">🚧</div>
          <h3 class="font-bold text-slate-900 text-lg mb-1">{t.android}</h3>
          <span class="inline-block px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-sm font-bold">
            {t.androidStatus}
          </span>
        </div>
        
        <!-- macOS -->
        <div class="card-surface p-6 text-center">
          <div class="text-4xl mb-3">📅</div>
          <h3 class="font-bold text-slate-900 text-lg mb-1">{t.macos}</h3>
          <span class="inline-block px-3 py-1 bg-blue-50 text-blue-600 rounded-full text-sm font-bold">
            {t.macosStatus}
          </span>
        </div>
        
        <!-- iOS -->
        <div class="card-surface p-6 text-center">
          <div class="text-4xl mb-3">📅</div>
          <h3 class="font-bold text-slate-900 text-lg mb-1">{t.ios}</h3>
          <span class="inline-block px-3 py-1 bg-blue-50 text-blue-600 rounded-full text-sm font-bold">
            {t.iosStatus}
          </span>
        </div>
      </div>
      
      <!-- Community Section -->
      <div class="card-surface p-8 md:p-12 text-center">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center">
          <svg class="w-8 h-8 text-[#F05D23]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold mb-4 text-slate-900">{t.communityTitle}</h3>
        <p class="text-slate-600 font-medium text-lg max-w-2xl mx-auto mb-6">
          {t.communityText}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mt-8">
          <a href="https://github.com/cmaart/endure-website" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-slate-600 hover:text-[#F05D23] font-medium transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            {t.communityLink}
          </a>
          
          <div class="hidden sm:block w-1.5 h-1.5 rounded-full bg-slate-200"></div>
          
          <a href="https://www.instagram.com/endure_cycling_com/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-[#E1306C] hover:text-[#C13584] font-medium transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
            </svg>
            {t.instagramLink}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
