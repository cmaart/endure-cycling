---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { getTranslations } from '../i18n/translations';
import { changelog, getChangelogMeta, latestRelease, releaseCount, releasesSince } from '../i18n/changelog';
import StoreBadges from './StoreBadges.astro';
import { localeHref, localeUrl, siteUrl } from '../utils/paths';

interface Props {
  lang: 'en' | 'de';
}

const { lang } = Astro.props;
const t = getChangelogMeta(lang);
const tr = getTranslations(lang);
const homeHref = localeHref(lang);
const canonicalUrl = localeUrl(lang, '/changelog');

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString(lang === 'de' ? 'de-AT' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC'
  });

const cadenceText = t.cadenceText
  .replace('{count}', String(releaseCount))
  .replace('{since}', formatDate(releasesSince));

// One ItemList of the listed releases, plus the page's own modification date,
// so crawlers and answer engines can read the update cadence rather than infer it.
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": t.h1,
  "description": t.seoDescription,
  "url": canonicalUrl,
  "inLanguage": lang,
  "datePublished": changelog[changelog.length - 1].date,
  "dateModified": latestRelease.date,
  "about": {
    "@type": "SoftwareApplication",
    "name": "ENDURE",
    "softwareVersion": latestRelease.version,
    "url": siteUrl
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "numberOfItems": changelog.length,
    "itemListElement": changelog.map((entry, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": `ENDURE ${entry.version}`,
      "item": {
        "@type": "SoftwareApplication",
        "name": "ENDURE",
        "softwareVersion": entry.version,
        "datePublished": entry.date,
        "releaseNotes": [
          ...(entry[lang].added ?? []),
          ...(entry[lang].improved ?? []),
          ...(entry[lang].fixed ?? [])
        ].join(' ')
      }
    }))
  }
};

const groups: { key: 'added' | 'improved' | 'fixed'; label: string }[] = [
  { key: 'added', label: t.added },
  { key: 'improved', label: t.improved },
  { key: 'fixed', label: t.fixed }
];
---

<Layout title={t.seoTitle} description={t.seoDescription} lang={lang} breadcrumb={t.breadcrumb}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <main class="container mx-auto px-6 pt-10 pb-24 max-w-3xl text-slate-800">
    <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">{t.h1}</h1>
    <p class="text-lg leading-relaxed mb-6">{t.intro}</p>

    <p class="font-mono text-xs tracking-[0.04em] text-slate-500 mb-12">
      <span class="text-accent">{t.cadence}</span> · {cadenceText}
    </p>

    <ol class="space-y-10">
      {changelog.map((entry) => {
        const notes = entry[lang];
        return (
          <li class="card-surface p-6 md:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-4">
              <h2 class="text-xl font-bold text-slate-900">
                {t.version} {entry.version}
                {notes.headline && <span class="font-medium text-slate-600">: {notes.headline}</span>}
              </h2>
              <time datetime={entry.date} class="font-mono text-xs text-slate-500">{formatDate(entry.date)}</time>
            </div>
            {groups.map(({ key, label }) => {
              const items = notes[key];
              if (!items || items.length === 0) return null;
              return (
                <div class="mb-4 last:mb-0">
                  <h3 class="font-mono text-[11px] tracking-[0.08em] uppercase text-accent mb-2">{label}</h3>
                  <ul class="space-y-2">
                    {items.map((item) => (
                      <li class="flex items-start gap-3 leading-relaxed text-slate-700">
                        <span class="mt-[0.6em] flex-shrink-0 w-1.5 h-1.5 rounded-full bg-accent/70" aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </li>
        );
      })}
    </ol>

    <section class="text-center card-surface p-8 mt-14 mb-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-3">{tr.footer.ctaTitle1} {tr.footer.ctaTitle2}</h2>
      <p class="text-lg leading-relaxed mb-6">{tr.footer.ctaText}</p>
      <div class="flex flex-wrap justify-center items-center gap-4" data-placement="changelog">
        <StoreBadges lang={lang} lazy />
      </div>
    </section>

    <a href={homeHref} class="inline-flex items-center gap-2 text-accent font-semibold hover:underline">
      ← {t.backHome}
    </a>
  </main>
  <Footer />
</Layout>
