---
import { getTranslations } from '../i18n/translations';
import { config } from '../config';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).footer;
const currentYear = new Date().getFullYear();
const iosUrl = config.platforms.ios.url;
const androidUrl = config.platforms.android.url;
const androidTestHref = lang === 'de' ? '/de/android-test' : '/android-test';
const feedbackHref = lang === 'de' ? '/de/feedback' : '/feedback';
const aboutHref = lang === 'de' ? '/de/about' : '/about';
const guidesHref = lang === 'de' ? '/de/guides' : '/guides';
const vsZwiftHref = lang === 'de' ? '/de/vs/zwift' : '/vs/zwift';
const vsTrainerroadHref = lang === 'de' ? '/de/vs/trainerroad' : '/vs/trainerroad';
---

<footer class="relative overflow-hidden">
  <!-- Closing CTA -->
  <section id="download" class="relative px-6 pt-24 pb-20 md:px-16 md:pt-32 md:pb-24 text-center">
    <div class="absolute -bottom-64 left-1/2 -translate-x-1/2 w-[900px] h-[500px] pointer-events-none bg-[radial-gradient(ellipse_at_center,rgba(194,85,43,0.06),transparent_70%)]" aria-hidden="true"></div>

    <h2 data-reveal class="relative mb-5 font-extrabold text-4xl md:text-6xl leading-[1.05] tracking-[-0.03em] text-slate-900">
      {t.ctaTitle1}<br />
      <span class="text-accent">{t.ctaTitle2}</span>
    </h2>

    <div data-reveal data-reveal-delay="100" class="relative flex flex-col sm:flex-row gap-3.5 justify-center items-center mt-10">
      <a id="footer-btn-ios" href={iosUrl} target="_blank" rel="noopener" class="btn-primary w-full sm:w-auto">{t.ctaAppStore}</a>
      <a id="footer-btn-android" href={androidUrl} target="_blank" rel="noopener" class="btn-secondary w-full sm:w-auto">{t.ctaGooglePlay}</a>
    </div>
  </section>

  <!-- Link grid -->
  <div class="container mx-auto px-6 pt-16 pb-12 border-t border-slate-900/10">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href={lang === 'de' ? '/de' : '/'} class="inline-flex items-center gap-2.5 mb-4" aria-label="ENDURE">
          <span class="w-3 h-3 rounded-full bg-accent"></span>
          <span class="font-bold text-[19px] tracking-[0.12em] text-slate-900">ENDURE</span>
        </a>
        <p class="text-slate-600 max-w-md">
          {t.tagline}
        </p>
      </div>

      <!-- Links -->
      <div class="lg:col-start-4">
        <h4 class="font-bold mb-4 text-slate-900">{t.linksTitle}</h4>
        <ul class="space-y-2">
          <li>
            <a href="https://events.endure-cycling.com/" target="_blank" rel="noopener" class="text-slate-600 hover:text-accent transition-colors text-sm flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              {t.eventsCalendar}
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/endure_cycling_com/" target="_blank" rel="noopener" class="text-slate-600 hover:text-accent transition-colors text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
              </svg>
              {t.instagram}
            </a>
          </li>
          <li>
            <a href="https://github.com/cmaart/endure-website" target="_blank" rel="noopener" class="text-slate-600 hover:text-accent transition-colors text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              {t.github}
            </a>
          </li>
          <li>
            <a href={aboutHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.about}
            </a>
          </li>
          <li>
            <a href={guidesHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.guides}
            </a>
          </li>
          <li>
            <a href={vsZwiftHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.vsZwift}
            </a>
          </li>
          <li>
            <a href={vsTrainerroadHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.vsTrainerroad}
            </a>
          </li>
          <li>
            <a href={androidTestHref} class="text-slate-600 hover:text-accent transition-colors text-sm flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.523 2.227l1.39-2.41a.29.29 0 00-.503-.29l-1.408 2.44a8.59 8.59 0 00-3.502-.734 8.59 8.59 0 00-3.502.734L8.59-.473a.29.29 0 00-.504.29l1.391 2.41C6.57 3.636 4.5 6.544 4.5 9.958h15c0-3.414-2.07-6.322-4.977-7.731zM8.5 7.458a.75.75 0 110-1.5.75.75 0 010 1.5zm7 0a.75.75 0 110-1.5.75.75 0 010 1.5zM4.5 10.958v8a1 1 0 001 1h1v3.5a1.5 1.5 0 003 0v-3.5h5v3.5a1.5 1.5 0 003 0v-3.5h1a1 1 0 001-1v-8h-15zm-3 0a1.5 1.5 0 00-1.5 1.5v5a1.5 1.5 0 003 0v-5a1.5 1.5 0 00-1.5-1.5zm21 0a1.5 1.5 0 00-1.5 1.5v5a1.5 1.5 0 003 0v-5a1.5 1.5 0 00-1.5-1.5z"/>
              </svg>
              {t.androidTest}
            </a>
          </li>
          <li>
            <a href={feedbackHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.feedback}
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.privacy}
            </a>
          </li>
          <li>
            <a href="/terms" class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.terms}
            </a>
          </li>
          <li>
            <a href="/imprint" class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.imprint}
            </a>
          </li>
          <li>
            <a href="mailto:info@endure-cycling.com" class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.contact}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-slate-900/10 flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-slate-500">
      <div class="flex flex-col md:flex-row items-center gap-4">
        <p>&copy; {currentYear} {t.copyright}</p>
        <p>{t.made}</p>
      </div>

      <a
        href="https://www.strava.com"
        target="_blank"
        rel="noopener"
        class="opacity-75 hover:opacity-100 transition-opacity"
        aria-label="Powered by Strava"
      >
        <img
          src="/assets/pwrdBy_strava_orange/api_logo_pwrdBy_strava_stack_orange.svg"
          alt="Powered by Strava"
          class="h-8"
        />
      </a>
    </div>
  </div>
</footer>

<script>
  const footerButtons: Array<{ id: string; label: string }> = [
    { id: 'footer-btn-ios', label: 'ios_app_store' },
    { id: 'footer-btn-android', label: 'google_play_store' },
  ];

  for (const { id, label } of footerButtons) {
    const btn = document.getElementById(id);
    if (!btn) continue;
    btn.addEventListener('click', () => {
      // @ts-ignore
      if (typeof gtag !== 'undefined') {
        // @ts-ignore
        gtag('event', 'download_click', {
          'event_category': 'engagement',
          'event_label': label,
          'value': 1,
        });
      }
    });
  }
</script>