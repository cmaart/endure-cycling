---
import { getTranslations } from '../i18n/translations';
import { config } from '../config';
import { localeHref } from '../utils/paths';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const tr = getTranslations(lang);
const t = tr.footer;
const currentYear = new Date().getFullYear();
const iosUrl = config.platforms.ios.url;
const androidUrl = config.platforms.android.url;
const appStoreBadge = lang === 'de' ? '/assets/badges/app-store-badge-de.svg' : '/assets/badges/app-store-badge.svg';
const googlePlayBadge = lang === 'de' ? '/assets/badges/google-play-badge-de.svg' : '/assets/badges/google-play-badge.svg';
const feedbackHref = localeHref(lang, '/feedback');
const aboutHref = localeHref(lang, '/about');
const guidesHref = localeHref(lang, '/guides');
const vsZwiftHref = localeHref(lang, '/vs/zwift');
const vsTrainerroadHref = localeHref(lang, '/vs/trainerroad');

// The legal pages exist in English only, so they never take the /de prefix.
const privacyHref = localeHref('en', '/privacy');
const termsHref = localeHref('en', '/terms');
const imprintHref = localeHref('en', '/imprint');

// Feature landings + trainer compatibility get their own footer column so every
// page links to them, not just the homepage sections they expand on.
const featureLinks = [
  { href: localeHref(lang, '/features/zwift-click'), label: t.featureZwiftClick },
  { href: localeHref(lang, '/features/lactate-lt1-lt2'), label: t.featureLactate },
  { href: localeHref(lang, '/features/core-heat-zones'), label: t.featureCoreTemp },
  { href: localeHref(lang, '/features/ftp-vo2max-tracking'), label: t.featureFtp },
  { href: localeHref(lang, '/features/climbing-efficiency'), label: t.featureClimbing },
  { href: localeHref(lang, '/supported-trainers'), label: t.supportedTrainers },
];
---

<footer class="relative overflow-hidden">
  <!-- Closing CTA -->
  <section id="download" class="relative px-6 pt-24 pb-20 md:px-16 md:pt-32 md:pb-24 text-center">
    <div class="absolute -bottom-64 left-1/2 -translate-x-1/2 w-[900px] h-[500px] pointer-events-none bg-[radial-gradient(ellipse_at_center,rgba(194,85,43,0.06),transparent_70%)]" aria-hidden="true"></div>

    <h2 data-reveal class="relative mb-5 font-extrabold text-4xl md:text-6xl leading-[1.05] tracking-[-0.03em] text-slate-900">
      {t.ctaTitle1}<br />
      <span class="text-accent">{t.ctaTitle2}</span>
    </h2>

    <div data-reveal data-reveal-delay="100" class="relative flex flex-col sm:flex-row gap-4 justify-center items-center mt-10">
      <a id="footer-btn-ios" href={iosUrl} target="_blank" rel="noopener" aria-label={tr.hero.appStoreBadgeAlt}>
        <img src={appStoreBadge} alt={tr.hero.appStoreBadgeAlt} class="h-12 w-auto" />
      </a>
      <a id="footer-btn-android" href={androidUrl} target="_blank" rel="noopener" aria-label={tr.hero.googlePlayBadgeAlt}>
        <img src={googlePlayBadge} alt={tr.hero.googlePlayBadgeAlt} class="h-12 w-auto" />
      </a>
    </div>
  </section>

  <!-- Link grid -->
  <div class="container mx-auto px-6 pt-16 pb-12 border-t border-slate-900/10">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href={localeHref(lang)} class="inline-flex items-center gap-2.5 mb-4" aria-label="ENDURE">
          <span class="w-3 h-3 rounded-full bg-accent"></span>
          <span class="font-bold text-[19px] tracking-[0.12em] text-slate-900">ENDURE</span>
        </a>
        <p class="text-slate-600 max-w-md">
          {t.tagline}
        </p>
      </div>

      <!-- Features + compatibility -->
      <div class="lg:col-start-3">
        <h4 class="font-bold mb-4 text-slate-900">{t.featuresTitle}</h4>
        <ul class="space-y-2">
          {featureLinks.map((link) => (
            <li>
              <a href={link.href} class="text-slate-600 hover:text-accent transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links -->
      <div class="lg:col-start-4">
        <h4 class="font-bold mb-4 text-slate-900">{t.linksTitle}</h4>
        <ul class="space-y-2">
          <li>
            <a href="https://events.endure-cycling.com/" target="_blank" rel="noopener" class="text-slate-600 hover:text-accent transition-colors text-sm flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              {t.eventsCalendar}
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/endure_cycling_com/" target="_blank" rel="noopener" class="text-slate-600 hover:text-accent transition-colors text-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
              </svg>
              {t.instagram}
            </a>
          </li>
          <li>
            <a href={aboutHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.about}
            </a>
          </li>
          <li>
            <a href={guidesHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.guides}
            </a>
          </li>
          <li>
            <a href={vsZwiftHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.vsZwift}
            </a>
          </li>
          <li>
            <a href={vsTrainerroadHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.vsTrainerroad}
            </a>
          </li>
          <li>
            <a href={feedbackHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.feedback}
            </a>
          </li>
          <li>
            <a href={privacyHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.privacy}
            </a>
          </li>
          <li>
            <a href={termsHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.terms}
            </a>
          </li>
          <li>
            <a href={imprintHref} class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.imprint}
            </a>
          </li>
          <li>
            <a href="mailto:info@endure-cycling.com" class="text-slate-600 hover:text-accent transition-colors text-sm">
              {t.contact}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-slate-900/10 flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-slate-500">
      <div class="flex flex-col md:flex-row items-center gap-4">
        <p>&copy; {currentYear} {t.copyright}</p>
        <p>{t.made}</p>
      </div>

      <div class="flex items-center gap-5">
        <a
          href="https://www.strava.com"
          target="_blank"
          rel="noopener"
          class="opacity-75 hover:opacity-100 transition-opacity"
          aria-label="Powered by Strava"
        >
          <img
            src="/assets/pwrdBy_strava_orange/api_logo_pwrdBy_strava_stack_orange.svg"
            alt="Powered by Strava"
            class="h-8"
          />
        </a>

        <a
          href="https://intervals.icu"
          target="_blank"
          rel="noopener"
          class="opacity-75 hover:opacity-100 transition-opacity"
          aria-label="Works with intervals.icu"
        >
          <img
            src="/assets/intervals-icu/intervals-icu-logo-round.svg"
            alt="intervals.icu"
            class="h-8 w-8"
          />
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  const footerButtons: Array<{ id: string; label: string }> = [
    { id: 'footer-btn-ios', label: 'ios_app_store' },
    { id: 'footer-btn-android', label: 'google_play_store' },
  ];

  for (const { id, label } of footerButtons) {
    const btn = document.getElementById(id);
    if (!btn) continue;
    btn.addEventListener('click', () => {
      // @ts-ignore
      if (typeof gtag !== 'undefined') {
        // @ts-ignore
        gtag('event', 'download_click', {
          'event_category': 'engagement',
          'event_label': label,
          'value': 1,
        });
      }
    });
  }
</script>