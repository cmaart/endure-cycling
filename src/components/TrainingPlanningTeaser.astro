---
/**
 * Homepage teaser for training planning, the first section after the hero
 * (AI coach first, 2026-10-28). Links to the feature page and to the web app.
 */
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';
import WebAppLink from './WebAppLink.astro';
import BetaTag from './BetaTag.astro';
import { webAppImage } from '../webAppImages';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).trainingPlanningTeaser;
const pageHref = localeHref(lang, '/features/training-planning');
const img = webAppImage(lang, 'weekRow');
---

<section id="training-planning" class="py-20 md:py-28">
  <div class="container mx-auto px-6">
    <div data-reveal class="max-w-5xl mx-auto bg-white border border-slate-200 rounded-3xl p-6 md:p-12 flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-3 font-mono text-[13px] tracking-[0.04em] text-accent mb-5">
          <span class="inline-block w-10 h-px bg-accent" aria-hidden="true"></span>
          {t.eyebrow}
        </div>
        <h2 class="text-3xl md:text-[46px] font-extrabold tracking-[-0.03em] leading-[1.06] text-slate-900 text-balance mb-5">
          {t.headline}<BetaTag />
        </h2>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-6">{t.description}</p>
        <ul class="flex flex-wrap gap-2 mb-6">
          {t.chips.map((chip) => (
            <li class="rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1.5 text-sm font-medium text-slate-700">{chip}</li>
          ))}
        </ul>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
          <a href={pageHref} class="inline-flex items-center min-h-11 text-accent-hover font-semibold hover:underline">{t.link} →</a>
          <WebAppLink lang={lang} placement="home-teaser" label={t.webLink} />
        </div>
      </div>
      <div class="w-full lg:basis-[48%] lg:shrink-0">
        <img
          src={img.src}
          alt={t.imageAlt}
          width={img.width}
          height={img.height}
          loading="lazy"
          decoding="async"
          class="w-full h-auto rounded-2xl border border-slate-200"
        />
      </div>
    </div>
  </div>
</section>
