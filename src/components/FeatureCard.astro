---
interface Props {
  title: string;
  features: string[];
  stat: string;
}

const { title, features, stat } = Astro.props;
---

<div class="card-surface hover-lift p-8 md:p-9 h-full">
  <!-- Big stat headline -->
  <div class="font-bold text-[34px] leading-none text-accent">{stat}</div>

  <!-- Title -->
  <h3 class="text-xl font-bold mt-4 mb-4 text-slate-900">{title}</h3>

  <!-- Features list -->
  <ul class="space-y-3">
    {features.map((feature) => (
      <li class="flex items-start gap-3 text-slate-600 text-sm leading-relaxed">
        <span class="mt-[7px] flex-shrink-0 w-1.5 h-1.5 rounded-full bg-accent"></span>
        <span set:html={feature} />
      </li>
    ))}
  </ul>
</div>