---
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).betaNotice;
---

<section class="py-12 relative overflow-hidden">
  <!-- Subtle background -->
  <div class="absolute inset-0 bg-slate-50 dark:bg-[#111318]"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-3xl mx-auto text-center" data-reveal>
      <!-- Early Release Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white dark:bg-[#1a1c22] border border-[#F05D23]/30 shadow-sm mb-4">
        <svg class="w-4 h-4 text-[#F05D23]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
        </svg>
        <span class="text-sm font-bold text-[#F05D23]">{t.badge}</span>
      </div>

      <!-- Title -->
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="text-gradient-primary">{t.title}</span>
      </h2>

      <!-- Description -->
      <p class="text-slate-600 dark:text-gray-400 font-medium text-lg leading-relaxed">
        {t.description}
      </p>
    </div>
  </div>
</section>
