---
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).betaNotice;
---

<section class="py-16 relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-3xl mx-auto text-center" data-reveal>
      <!-- Early Release Badge -->
      <div class="inline-flex items-center gap-2.5 mono-label uppercase border border-accent/30 rounded-full px-4 py-1.5 mb-6">
        <span class="inline-block w-2 h-2 bg-accent rounded-full animate-pulse"></span>
        {t.badge}
      </div>

      <!-- Title -->
      <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.02em] mb-4 text-slate-900">
        {t.title}
      </h2>

      <!-- Description -->
      <p class="text-slate-600 text-lg leading-relaxed">
        {t.description}
      </p>
    </div>
  </div>
</section>