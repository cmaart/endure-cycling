---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { getTranslations } from '../i18n/translations';
import { getGuide, getGuidesIndex, guides, type GuideKey } from '../i18n/guides';
import { config } from '../config';
import StoreBadges from './StoreBadges.astro';
import { localeHref, localeUrl, siteUrl } from '../utils/paths';
import ArticleHero from './ArticleHero.astro';
import ArticleAside from './ArticleAside.astro';
import ArticleSection from './ArticleSection.astro';
import { sectionId } from '../i18n/article';

interface Props {
  lang: 'en' | 'de';
  guide: GuideKey;
}

const { lang, guide } = Astro.props;
const t = getGuide(lang, guide);
const tr = getTranslations(lang);
const guidesHref = localeHref(lang, '/guides');
const index = getGuidesIndex(lang);

// Sibling guides, derived from the content map rather than maintained per guide.
// Adding a guide links it from every other one automatically.
const siblings = (Object.entries(guides[lang]) as [GuideKey, typeof t][])
  .filter(([slug]) => slug !== guide)
  .slice(0, 3);

const canonicalUrl = localeUrl(lang, `/guides/${guide}`);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": t.h1,
  "description": t.seoDescription,
  "datePublished": t.datePublished,
  "dateModified": t.dateModified,
  "inLanguage": lang,
  "image": `${siteUrl}/assets/og/endure-og.jpg`,
  "mainEntityOfPage": canonicalUrl,
  // Named author for E-E-A-T; mirrors the Person entity on /about.
  "author": {
    "@type": "Person",
    "name": "Christoph Martin",
    "url": localeUrl('en', '/about'),
    "worksFor": { "@type": "Organization", "name": "ENDURE", "url": siteUrl }
  },
  "publisher": {
    "@type": "Organization",
    "name": "ENDURE",
    "url": siteUrl,
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/assets/ENDURE_lockup_exact_icon_4k.png` }
  }
};
---

<Layout title={t.seoTitle} description={t.seoDescription} lang={lang} breadcrumb={t.h1}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <!--
    Two layouts share this markup. A guide with `hero` gets the picture hero
    and the sticky download rail; every other guide keeps the single column.
  -->
  <main class:list={['pb-24 text-slate-800', !t.hero && 'container mx-auto px-6 pt-10 max-w-3xl']}>
    {t.hero && (
      <ArticleHero lang={lang} title={t.h1} image={t.hero} note={t.heroNote} placement="guide_hero" />
    )}
    <div class:list={[t.hero && 'page-container mt-12 grid gap-x-16 lg:mt-16 lg:grid-cols-[minmax(0,1fr)_18rem]']}>
    <div class:list={[t.hero && 'max-w-3xl']}>
    <article>
      {!t.hero && <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6 leading-tight">{t.h1}</h1>}

      <!-- Direct answer (featured-snippet target) -->
      <p class="text-lg leading-relaxed font-medium bg-accent/[0.06] rounded-2xl px-6 py-5 mb-12">
        {t.directAnswer}
      </p>

      <div class="space-y-12">
        {t.sections.map((section, i) => (
          <ArticleSection
            id={sectionId(i)}
            title={section.title}
            body={section.body}
            bullets={section.bullets}
            ordered={section.ordered}
            image={section.image}
            video={section.video}
          />
        ))}
      </div>

      <!-- CTA -->
      <section class="text-center card-surface p-8 mt-14 mb-10">
        <h2 class="text-2xl font-bold text-slate-900 mb-3">{t.ctaTitle}</h2>
        <p class="text-lg leading-relaxed mb-6">{t.ctaBody}</p>
        <div data-placement="guide_cta" class="flex flex-wrap justify-center items-center gap-4">
          <StoreBadges lang={lang} lazy />
        </div>
      </section>
    </article>

    <!-- Sibling guides: keeps the guide cluster internally linked -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-slate-900 mb-4">{index.moreGuides}</h2>
      <ul class="space-y-2">
        {siblings.map(([slug, sibling]) => (
          <li>
            <a href={localeHref(lang, `/guides/${slug}`)} class="text-accent font-semibold hover:underline">
              {sibling.h1} →
            </a>
          </li>
        ))}
      </ul>
    </section>

    <a href={guidesHref} class="inline-flex items-center gap-2 text-accent font-semibold hover:underline">
      ← {t.backToGuides}
    </a>
    </div>
    {t.hero && (
      <ArticleAside lang={lang} sections={t.sections.map((section) => section.title)} title={t.ctaTitle} placement="guide_rail" />
    )}
    </div>
  </main>
  <Footer />
</Layout>
