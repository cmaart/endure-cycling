---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { getTranslations } from '../i18n/translations';
import { getGuide, getGuidesIndex, guides, type GuideKey } from '../i18n/guides';
import { config } from '../config';
import { localeHref, localeUrl, siteUrl } from '../utils/paths';

interface Props {
  lang: 'en' | 'de';
  guide: GuideKey;
}

const { lang, guide } = Astro.props;
const t = getGuide(lang, guide);
const tr = getTranslations(lang);
const guidesHref = localeHref(lang, '/guides');
const index = getGuidesIndex(lang);

// Sibling guides, derived from the content map rather than maintained per guide —
// adding a guide links it from every other one automatically.
const siblings = (Object.entries(guides[lang]) as [GuideKey, typeof t][])
  .filter(([slug]) => slug !== guide)
  .slice(0, 3);
const appStoreBadge = lang === 'de' ? '/assets/badges/app-store-badge-de.svg' : '/assets/badges/app-store-badge.svg';
const googlePlayBadge = lang === 'de' ? '/assets/badges/google-play-badge-de.svg' : '/assets/badges/google-play-badge.svg';

const canonicalUrl = localeUrl(lang, `/guides/${guide}`);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": t.h1,
  "description": t.seoDescription,
  "datePublished": t.datePublished,
  "dateModified": t.dateModified,
  "inLanguage": lang,
  "mainEntityOfPage": canonicalUrl,
  "author": {
    "@type": "Organization",
    "name": "ENDURE",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "ENDURE",
    "url": siteUrl,
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/assets/ENDURE_lockup_exact_icon_4k.png` }
  }
};
---

<Layout title={t.seoTitle} description={t.seoDescription} lang={lang} breadcrumb={t.h1}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <main class="container mx-auto px-6 pt-10 pb-24 max-w-3xl text-slate-800">
    <article>
      <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6 leading-tight">{t.h1}</h1>

      <!-- Direct answer (featured-snippet target) -->
      <p class="text-lg leading-relaxed font-medium bg-slate-50 border-l-4 border-accent rounded-r-xl px-6 py-5 mb-12">
        {t.directAnswer}
      </p>

      <div class="space-y-12">
        {t.sections.map((section) => (
          <section>
            <h2 class="text-2xl font-bold text-slate-900 mb-3">{section.title}</h2>
            <p class="text-lg leading-relaxed">{section.body}</p>
            {section.bullets && (
              <ul class="mt-4 space-y-3">
                {section.bullets.map((bullet) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1.5 flex-shrink-0 w-5 h-5 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center">
                      <svg class="w-3 h-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                      </svg>
                    </span>
                    <!--
                      Bullets carry inline markup (`<strong>` on the lead-in
                      term), so they render with set:html like every other
                      bullet list on the site. Section bodies stay plain text.
                    -->
                    <span class="text-lg leading-relaxed font-medium" set:html={bullet} />
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>

      <!-- CTA -->
      <section class="text-center card-surface p-8 mt-14 mb-10">
        <h2 class="text-2xl font-bold text-slate-900 mb-3">{t.ctaTitle}</h2>
        <p class="text-lg leading-relaxed mb-6">{t.ctaBody}</p>
        <div class="flex flex-wrap justify-center items-center gap-4">
          {config.platforms.ios.available && config.platforms.ios.url && (
            <a href={config.platforms.ios.url} target="_blank" rel="noopener" aria-label={tr.hero.appStoreBadgeAlt}>
              <img src={appStoreBadge} alt={tr.hero.appStoreBadgeAlt} class="h-12 w-auto" />
            </a>
          )}
          {config.platforms.android.available && config.platforms.android.url && (
            <a href={config.platforms.android.url} target="_blank" rel="noopener" aria-label={tr.hero.googlePlayBadgeAlt}>
              <img src={googlePlayBadge} alt={tr.hero.googlePlayBadgeAlt} class="h-12 w-auto" />
            </a>
          )}
        </div>
      </section>
    </article>

    <!-- Sibling guides: keeps the guide cluster internally linked -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-slate-900 mb-4">{index.moreGuides}</h2>
      <ul class="space-y-2">
        {siblings.map(([slug, sibling]) => (
          <li>
            <a href={localeHref(lang, `/guides/${slug}`)} class="text-accent font-semibold hover:underline">
              {sibling.h1} →
            </a>
          </li>
        ))}
      </ul>
    </section>

    <a href={guidesHref} class="inline-flex items-center gap-2 text-accent font-semibold hover:underline">
      ← {t.backToGuides}
    </a>
  </main>
  <Footer />
</Layout>