---
/**
 * Homepage hero, photo-editorial (2026-11-10, prototype "C"): a full-bleed
 * ride photo, the headline in the sky, subline and store badges on the road,
 * the coach screen on a phone at the right. Nav floats over it
 * (Layout `navOverlay`). Below `lg` the photo ends above the text, which sits
 * on a dark ground continuing the grass, so nothing covers the rider. There
 * the store badges come straight after the photo and before the subline, so
 * they sit on the first screen of a phone (2026-11-13: under the subline they
 * started at 851px on a 750px screen and download clicks dropped).
 */
import { Picture } from 'astro:assets';
import { getTranslations } from '../i18n/translations';
import { config } from '../config';
import WebAppLink from './WebAppLink.astro';
import { appShotDir } from '../utils/appShots';
import ridePhoto from '../assets/hero/ride-field.jpg';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).hero;
const screens = getTranslations(lang).appScreens;
const iosUrl = config.platforms.ios.url;
const androidUrl = config.platforms.android.url;
const windowsUrl = config.platforms.windows.url;
const microsoftStoreBadge = lang === 'de' ? '/assets/badges/microsoft-store-badge-de.svg' : '/assets/badges/microsoft-store-badge.svg';
const appStoreBadge = lang === 'de' ? '/assets/badges/app-store-badge-de.svg' : '/assets/badges/app-store-badge.svg';
const googlePlayBadge = lang === 'de' ? '/assets/badges/google-play-badge-de.svg' : '/assets/badges/google-play-badge.svg';
const coachShot = `${appShotDir(lang)}/ai_coaching.webp`;
---

<header class="hero relative isolate overflow-hidden text-white">
  <!-- Photo: full bleed from lg, the top part of the hero below it. -->
  <div class="hero-photo" aria-hidden="true">
    <Picture
      src={ridePhoto}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2560, 3200, 3840]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-photo-img"
    />
  </div>

  <div class="hero-head">
    <h1 class="hero-title page-container font-extrabold">
      <span class="hero-line"><span style="--i:0">{t.headline1}</span></span>
      <span class="hero-line hero-line--thin"><span style="--i:1">{t.headline2}</span></span>
    </h1>
    <!-- In the sky under the headline, so the road stays clear for the rider. -->
    <div class="hero-copy page-container hero-enter" style="--i:3">
      <p class="text-[17px] md:text-lg leading-relaxed text-white/95 text-pretty hero-shadow">{t.subline}</p>
      <!--
        Keyword-bearing line. The H1 carries the claim, so this is where the
        terms riders search for live. Deliberately quiet.
      -->
      <p class="mt-2 text-sm text-white/75 text-pretty hero-shadow">{t.seoLine}</p>
    </div>
  </div>

  <div class="hero-foot page-container">
    <div class="hero-enter" style="--i:5">
      <div data-placement="hero" class="hero-badges flex flex-wrap gap-3 items-center">
        <a id="download-btn-ios" href={iosUrl} target="_blank" rel="noopener" aria-label={t.appStoreBadgeAlt} class="hero-badge">
          <img src={appStoreBadge} alt={t.appStoreBadgeAlt} width="135" height="40" class="h-11 md:h-12 w-auto" />
        </a>
        <a id="download-btn-android" href={androidUrl} target="_blank" rel="noopener" aria-label={t.googlePlayBadgeAlt} class="hero-badge">
          <img src={googlePlayBadge} alt={t.googlePlayBadgeAlt} width="135" height="40" class="h-11 md:h-12 w-auto" />
        </a>
        <!-- Official Microsoft Store badge (get.microsoft.com/images, dark). -->
        <a id="download-btn-windows" href={windowsUrl} target="_blank" rel="noopener" aria-label={t.microsoftStoreBadgeAlt} class="hero-badge hero-badge--windows">
          <img src={microsoftStoreBadge} alt={t.microsoftStoreBadgeAlt} width={lang === 'de' ? 183 : 161} height="44" class="h-11 md:h-12 w-auto" />
        </a>
      </div>
      <!-- Android visitors get Google Play first. Inline so it runs before paint. -->
      <script is:inline>
        if (/Android/i.test(navigator.userAgent)) document.querySelector('.hero-badges')?.classList.add('hero-badges--android');
      </script>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-white/85">
        {t.checks.map((check) => (
          <li class="inline-flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0 text-[#F08A5D]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" /></svg>
            {check}
          </li>
        ))}
      </ul>
      <div class="mt-2">
        <WebAppLink lang={lang} placement="hero-web" class="!text-white" />
      </div>
    </div>

    <!-- The coach screen, from lg. Opens full size in the shared Lightbox. -->
    <button
      type="button"
      class="hero-phone hero-enter"
      style="--i:6"
      data-lightbox-src={coachShot}
      data-lightbox-alt={screens.coaching.alt}
      aria-label={t.screenshotAction.replace('{name}', screens.coaching.label)}
    >
      <img src={coachShot} alt="" width="300" height="657" decoding="async" class="block w-full rounded-[30px]" />
    </button>
  </div>
</header>

<style>
  /* Mobile first: three grid rows share one column; the photo spans the first
     two (headline + open sky and rider), the text sits in the third on a dark
     ground that continues the grass. */
  .hero {
    display: grid;
    /* headline | sky and rider | badges | subline */
    grid-template-rows: auto minmax(30svh, 1fr) auto auto;
    background: #12170f;
  }
  .hero-photo {
    grid-row: 1 / 3;
    grid-column: 1;
    position: relative;
    z-index: -1;
    overflow: hidden;
  }
  .hero-photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 70%;
    animation: settle 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(8 30 50 / 0.5), rgb(8 30 50 / 0.15) 50%, rgb(18 23 15 / 0) 72%, #12170f);
  }
  /* Below lg the head's two parts take their own rows: the headline over the
     photo, the subline under it, so the rider stays clear. */
  .hero-head { display: contents; }
  .hero-title {
    grid-row: 1;
    grid-column: 1;
    /* room for the floating nav, which is taller below lg (link strip) */
    padding-top: 150px;
  }
  .hero-copy {
    grid-row: 4;
    grid-column: 1;
    padding-top: 28px;
    padding-bottom: 48px;
  }
  .hero-copy > p { max-width: 40rem; }
  .hero-foot {
    grid-row: 3;
    grid-column: 1;
    padding-top: 12px;
  }

  .hero-title {
    font-size: clamp(46px, 7.4vw, 116px);
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-shadow: 0 2px 30px rgb(0 30 60 / 0.25);
  }
  /* Each line rises out of its own mask. The padding keeps descenders (g, p)
     inside the mask; the negative margin gives the space back. */
  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
  }
  .hero-line > span {
    display: block;
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 120ms + 250ms);
  }
  .hero-line--thin {
    font-size: 0.46em;
    margin-top: 0.3em;
    padding-bottom: 0.2em;
  }
  .hero-line--thin > span {
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
  }
  .hero-enter {
    animation: enter 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    animation-delay: calc(var(--i) * 90ms + 250ms);
  }
  .hero-shadow { text-shadow: 0 1px 18px rgb(0 25 50 / 0.45); }
  .hero-badge { display: block; transition: transform 0.2s ease; }
  .hero-badge:hover { transform: translateY(-2px); }
  .hero-badges--android #download-btn-android { order: -1; }
  /* A phone or tablet cannot install the Windows app; without it the two
     mobile stores fit on one row. */
  @media (hover: none) and (pointer: coarse) and (max-width: 1023px) {
    .hero-badge--windows { display: none; }
  }

  .hero-phone {
    display: none;
    width: 240px;
    padding: 9px;
    border-radius: 40px;
    background: #0b0b0c;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08), 0 40px 80px -30px rgb(0 0 0 / 0.6);
    cursor: zoom-in;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-phone:hover { transform: translateY(-4px); }
  .hero-phone:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }

  @media (min-width: 1024px) {
    .hero {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 100svh;
      min-height: max(100svh, 760px);
    }
    .hero-photo { position: absolute; inset: 0; }
    .hero-photo :global(img) { object-position: 35% 60%; }
    .hero-photo::after {
      background: linear-gradient(180deg, rgb(8 30 50 / 0.45), rgb(8 30 50 / 0.12) 38%, rgb(0 0 0 / 0) 55%, rgb(0 0 0 / 0.6));
    }
    .hero-head { display: block; padding-top: 116px; }
    .hero-title { padding-top: 0; }
    .hero-copy { margin-top: 28px; padding-block: 0; }
    .hero-foot { padding-top: 28px; padding-bottom: 48px; }
    /* The phone sits on the container's right edge, out of the flow, so it
       never makes the hero taller than the screen. */
    .hero-phone {
      display: block;
      position: absolute;
      right: max(4rem, calc((100vw - 1248px) / 2 + 4rem));
      bottom: 48px;
      width: min(230px, 17vw);
    }
  }

  @keyframes settle { from { transform: scale(1.07); } to { transform: none; } }
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes enter { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo :global(img), .hero-line > span, .hero-enter { animation: none; }
    .hero-badge, .hero-phone { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.hero [data-lightbox-src]').forEach((el) => {
    el.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('lightbox:open', {
        detail: { src: el.dataset.lightboxSrc, alt: el.dataset.lightboxAlt },
      }));
    });
  });
</script>
