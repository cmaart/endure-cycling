---
import { getTranslations } from '../i18n/translations';
import { config } from '../config';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).hero;
const iosUrl = config.platforms.ios.url;
const androidUrl = config.platforms.android.url;
---

<header class="relative px-6 pt-16 pb-20 md:px-16 md:pt-20 md:pb-28 overflow-hidden">
  <!-- Accent glow behind the headline -->
  <div class="absolute -top-56 left-1/2 -translate-x-1/2 w-[900px] h-[600px] pointer-events-none bg-[radial-gradient(ellipse_at_center,rgba(194,85,43,0.08),rgba(194,85,43,0.03)_45%,transparent_70%)]" aria-hidden="true"></div>

  <div class="relative text-center max-w-3xl mx-auto">
    <!-- Badge -->
    <div data-reveal class="inline-flex items-center gap-2.5 rounded-full border border-slate-900/15 bg-slate-900/5 backdrop-blur-md px-5 py-2 text-sm text-slate-600 mb-8">
      <span class="w-[7px] h-[7px] rounded-full bg-accent"></span>
      {t.badge}
    </div>

    <!-- Headline -->
    <h1 data-reveal data-reveal-delay="100" class="mb-6 font-extrabold text-5xl md:text-7xl lg:text-[84px] leading-[1.04] tracking-[-0.03em] text-slate-900 text-balance">
      {t.headline1}<br />
      <span class="text-accent">{t.headline2}</span>
    </h1>

    <!-- Subline -->
    <p data-reveal data-reveal-delay="200" class="mx-auto mb-5 max-w-xl text-lg md:text-xl leading-relaxed text-slate-600 text-pretty">
      {t.subline}
    </p>

    <!--
      Keyword-bearing H2. The H1 above carries the claim, so this is where the
      terms riders search for live. Deliberately quiet in the visual hierarchy.
    -->
    <h2 data-reveal data-reveal-delay="250" class="mx-auto mb-10 max-w-xl text-sm md:text-base font-medium tracking-[0.01em] text-slate-500 text-pretty">
      {t.seoLine}
    </h2>

    <!-- CTAs -->
    <div data-reveal data-reveal-delay="300" class="flex flex-col sm:flex-row gap-3.5 justify-center items-center">
      <a id="download-btn-ios" href={iosUrl} target="_blank" rel="noopener" class="btn-primary w-full sm:w-auto">{t.ctaIos}</a>
      <a id="download-btn-android" href={androidUrl} target="_blank" rel="noopener" class="btn-secondary w-full sm:w-auto">{t.ctaAndroid}</a>
    </div>

    <p data-reveal data-reveal-delay="400" class="mt-5 text-xs text-slate-500">{t.desktopNote}</p>
    <p data-reveal data-reveal-delay="400" class="mt-2 text-sm text-slate-500 flex items-center justify-center gap-2">
      <span class="inline-block w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
      {t.secondary}
    </p>
  </div>

  <!-- Floating phone trio — click a side phone (or swipe) to bring it into focus -->
  <div id="phone-stage" data-reveal class="relative mt-16 md:mt-20 mx-auto w-full max-w-[820px] h-[460px] md:h-[680px]">
    <div class="hero-phone slot-left" role="button" tabindex="0" aria-label="Show dashboard screenshot">
      <div class="phone-frame rounded-[32px] md:rounded-[40px] animate-float-tilt">
        <img src="/assets/dark_theme/dashboard_profile.png" alt="ENDURE dashboard with fitness profile" width="300" height="650" loading="eager" class="w-full" />
      </div>
    </div>
    <div class="hero-phone slot-center" role="button" tabindex="0" aria-label="Show ride screen screenshot">
      <div class="phone-frame rounded-[32px] md:rounded-[40px] animate-float">
        <img src="/assets/dark_theme/workout_ride.png" alt="ENDURE ride screen with smart trainer control" width="300" height="650" loading="eager" class="w-full" />
      </div>
    </div>
    <div class="hero-phone slot-right" role="button" tabindex="0" aria-label="Show performance trends screenshot">
      <div class="phone-frame rounded-[32px] md:rounded-[40px] animate-float-tilt [animation-delay:0.6s]">
        <img src="/assets/dark_theme/performance_trends.png" alt="ENDURE FTP and VO2max performance trends" width="300" height="650" loading="eager" class="w-full" />
      </div>
    </div>
    <div class="hero-phone slot-hidden" role="button" tabindex="0" aria-label="Show power analysis screenshot">
      <div class="phone-frame rounded-[32px] md:rounded-[40px] animate-float-tilt [animation-delay:0.9s]">
        <img src="/assets/screenshots/power_analysis.png" alt="ENDURE power profile and time in zones analysis" width="300" height="624" loading="lazy" class="w-full" />
      </div>
    </div>
    <div class="hero-phone slot-hidden" role="button" tabindex="0" aria-label="Show workout player screenshot">
      <div class="phone-frame rounded-[32px] md:rounded-[40px] animate-float-tilt [animation-delay:1.2s]">
        <img src="/assets/screenshots/workout_player.png" alt="ENDURE workout player with interval targets" width="300" height="626" loading="lazy" class="w-full" />
      </div>
    </div>

    <!-- Stat chips -->
    <div data-reveal class="stat-chip absolute z-20 top-2 left-0 md:top-10 md:-left-2 lg:-left-8 animate-float [animation-delay:0.3s]">
      <div class="font-mono text-[10px] md:text-xs text-accent">FTP TREND</div>
      <div class="font-bold text-base md:text-2xl text-slate-900">↗ 284 W</div>
    </div>
    <div data-reveal class="stat-chip absolute z-20 bottom-14 right-0 md:bottom-28 md:-right-2 lg:-right-10 animate-float [animation-delay:1s]">
      <div class="font-mono text-[10px] md:text-xs text-accent">VO2MAX</div>
      <div class="font-bold text-base md:text-2xl text-slate-900">58.2</div>
    </div>
  </div>

  <!-- Dot indicators — one per screenshot, active dot follows the centered phone -->
  <div id="phone-dots" data-reveal class="relative z-10 mt-8 flex justify-center items-center gap-2.5"></div>
</header>

<style>
  /* Slot transforms live on the outer wrapper; the float keyframes animate the
     inner .phone-frame, so the two transforms never fight. */
  .hero-phone {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 200px;
    transform: translateX(calc(-50% + var(--tx))) scale(var(--s));
    transform-origin: bottom center;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .slot-left   { --tx: -110px; --s: 0.64; z-index: 1; cursor: pointer; }
  .slot-center { --tx: 0px;    --s: 1;    z-index: 10; cursor: zoom-in; }
  .slot-right  { --tx: 110px;  --s: 0.64; z-index: 1; cursor: pointer; }
  .slot-hidden { --tx: 0px;    --s: 0.5;  z-index: 0; opacity: 0; pointer-events: none; }

  /* :global — the dots are created in JS, so they don't carry Astro's scope attribute */
  :global(.phone-dot) {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: rgb(203 213 225); /* slate-300 */
    cursor: pointer;
    padding: 0;
    border: none;
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  :global(.phone-dot:hover) {
    background: rgb(148 163 184); /* slate-400 */
  }
  :global(.phone-dot.active) {
    width: 24px;
    background: var(--color-accent);
  }

  .slot-left:hover,
  .slot-right:hover {
    --s: 0.68;
  }

  @media (min-width: 768px) {
    .hero-phone { width: 300px; }
    .slot-left   { --tx: -265px; --s: 0.77; }
    .slot-right  { --tx: 265px;  --s: 0.77; }
    .slot-left:hover,
    .slot-right:hover { --s: 0.81; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-phone { transition: none; }
  }
</style>

<script>
  const stage = document.getElementById('phone-stage');

  if (stage) {
    const phones = Array.from(stage.querySelectorAll<HTMLElement>('.hero-phone'));
    const n = phones.length;

    // Phones form a ring in DOM order; only center and its two neighbours are visible.
    let center = phones.findIndex((p) => p.classList.contains('slot-center'));

    // One dot per phone, active dot = centered phone
    const dotsContainer = document.getElementById('phone-dots');
    const dots = phones.map((p, i) => {
      const dot = document.createElement('button');
      dot.className = 'phone-dot';
      dot.type = 'button';
      dot.setAttribute('aria-label', p.getAttribute('aria-label') ?? `Show screenshot ${i + 1}`);
      dot.addEventListener('click', () => {
        center = i;
        apply();
      });
      dotsContainer?.appendChild(dot);
      return dot;
    });

    const apply = () => {
      phones.forEach((p, i) => {
        p.classList.remove('slot-left', 'slot-center', 'slot-right', 'slot-hidden');
        if (i === center) p.classList.add('slot-center');
        else if (i === (center - 1 + n) % n) p.classList.add('slot-left');
        else if (i === (center + 1) % n) p.classList.add('slot-right');
        else p.classList.add('slot-hidden');
      });
      dots.forEach((d, i) => {
        d.classList.toggle('active', i === center);
        d.setAttribute('aria-current', i === center ? 'true' : 'false');
      });
    };
    apply();

    // dir = +1 brings the right phone to center, -1 brings the left one.
    const rotate = (dir: number) => {
      center = (center + dir + n) % n;
      apply();
    };

    // Center phone opens the lightbox with its full-size screenshot
    const zoomCenter = (p: HTMLElement) => {
      const img = p.querySelector('img');
      if (!img) return;
      document.dispatchEvent(new CustomEvent('lightbox:open', {
        detail: { src: img.src, alt: img.alt },
      }));
    };

    phones.forEach((p) => {
      p.addEventListener('click', () => {
        if (p.classList.contains('slot-right')) rotate(1);
        else if (p.classList.contains('slot-left')) rotate(-1);
        else zoomCenter(p);
      });
      p.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        if (p.classList.contains('slot-right')) rotate(1);
        else if (p.classList.contains('slot-left')) rotate(-1);
        else zoomCenter(p);
      });
    });

    // Horizontal swipe on touch devices
    let startX: number | null = null;
    stage.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      startX = null;
      if (Math.abs(dx) < 40) return;
      rotate(dx < 0 ? 1 : -1);
    }, { passive: true });
  }
</script>

<script>
  const storeButtons: Array<{ id: string; label: string }> = [
    { id: 'download-btn-ios', label: 'ios_app_store' },
    { id: 'download-btn-android', label: 'google_play_store' },
  ];

  for (const { id, label } of storeButtons) {
    const btn = document.getElementById(id);
    if (!btn) continue;
    btn.addEventListener('click', () => {
      // @ts-ignore
      if (typeof gtag !== 'undefined') {
        // @ts-ignore
        gtag('event', 'download_click', {
          'event_category': 'engagement',
          'event_label': label,
          'value': 1,
        });
      }
    });
  }
</script>