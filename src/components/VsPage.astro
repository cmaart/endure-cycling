---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { getTranslations } from '../i18n/translations';
import { getVsContent, type VsKey } from '../i18n/vs';
import { config } from '../config';

interface Props {
  lang: 'en' | 'de';
  competitor: VsKey;
}

const { lang, competitor } = Astro.props;
const t = getVsContent(lang, competitor);
const tr = getTranslations(lang);
const homeHref = lang === 'de' ? '/de' : '/';
const appStoreBadge = lang === 'de' ? '/assets/badges/app-store-badge-de.svg' : '/assets/badges/app-store-badge.svg';
const googlePlayBadge = lang === 'de' ? '/assets/badges/google-play-badge-de.svg' : '/assets/badges/google-play-badge.svg';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faq.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
};
---

<Layout title={t.seoTitle} description={t.seoDescription} lang={lang} breadcrumb={t.breadcrumb}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <main class="container mx-auto px-6 pt-10 pb-24 max-w-4xl text-slate-800">
    <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-3">{t.h1}</h1>
    <p class="text-xl md:text-2xl text-slate-600 font-semibold mb-8">{t.subtitle}</p>

    <!-- Direct answer (featured-snippet target) -->
    <p class="text-lg leading-relaxed font-medium bg-slate-50 border-l-4 border-accent rounded-r-xl px-6 py-5 mb-8">
      {t.directAnswer}
    </p>

    <p class="text-lg leading-relaxed mb-12">{t.intro}</p>

    <!-- Comparison table -->
    <div class="overflow-x-auto mb-14">
      <table class="w-full text-left border-collapse rounded-2xl overflow-hidden border border-slate-200">
        <caption class="sr-only">{t.tableCaption}</caption>
        <thead>
          <tr class="bg-slate-100">
            <th class="py-4 px-5 text-sm font-bold text-slate-900">{t.colFeature}</th>
            <th class="py-4 px-5 text-sm font-bold text-accent">{t.colEndure}</th>
            <th class="py-4 px-5 text-sm font-bold text-slate-900">{t.colOther}</th>
          </tr>
        </thead>
        <tbody>
          {t.rows.map((row, idx) => (
            <tr class={idx % 2 === 1 ? 'bg-slate-50' : ''}>
              <th scope="row" class="py-4 px-5 align-top font-semibold text-slate-900 border-t border-slate-200">
                {row.feature}
              </th>
              <td class="py-4 px-5 align-top text-slate-700 font-medium border-t border-slate-200">
                {row.endure}
              </td>
              <td class="py-4 px-5 align-top text-slate-600 font-medium border-t border-slate-200">
                {row.other}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!--
      Switch section: the "alternative" query is a migration intent, so the page
      answers "what do I lose by leaving?" before it compares features further.
    -->
    <section class="card-surface p-6 md:p-8 mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-5">{t.switchTitle}</h2>
      <ul class="space-y-3">
        {t.switchBullets.map((item) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center">
              <svg class="w-3 h-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="leading-relaxed font-medium text-slate-700" set:html={item} />
          </li>
        ))}
      </ul>
    </section>

    <!-- Choose lists -->
    <div class="grid md:grid-cols-2 gap-8 mb-14">
      <div class="card-surface p-6">
        <h2 class="text-xl font-bold text-slate-900 mb-4">{t.chooseEndureTitle}</h2>
        <ul class="space-y-3">
          {t.chooseEndure.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center">
                <svg class="w-3 h-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="font-medium">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="card-surface p-6">
        <h2 class="text-xl font-bold text-slate-900 mb-4">{t.chooseOtherTitle}</h2>
        <ul class="space-y-3">
          {t.chooseOther.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-slate-200 border border-slate-300 flex items-center justify-center">
                <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="font-medium">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Both -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-3">{t.bothTitle}</h2>
      <p class="text-lg leading-relaxed">{t.bothBody}</p>
    </section>

    <!-- FAQ -->
    <section class="mb-14 space-y-6">
      {t.faq.map((item) => (
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-900 mb-2">{item.q}</h2>
          <p class="leading-relaxed font-medium text-slate-600">{item.a}</p>
        </div>
      ))}
    </section>

    <!-- CTA -->
    <section class="text-center card-surface p-8 mb-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-3">{t.ctaTitle}</h2>
      <p class="text-lg leading-relaxed mb-6">{t.ctaBody}</p>
      <div class="flex flex-wrap justify-center items-center gap-4">
        {config.platforms.ios.available && config.platforms.ios.url && (
          <a href={config.platforms.ios.url} target="_blank" rel="noopener" aria-label={tr.hero.appStoreBadgeAlt}>
            <img src={appStoreBadge} alt={tr.hero.appStoreBadgeAlt} class="h-12 w-auto" />
          </a>
        )}
        {config.platforms.android.available && config.platforms.android.url && (
          <a href={config.platforms.android.url} target="_blank" rel="noopener" aria-label={tr.hero.googlePlayBadgeAlt}>
            <img src={googlePlayBadge} alt={tr.hero.googlePlayBadgeAlt} class="h-12 w-auto" />
          </a>
        )}
      </div>
    </section>

    <p class="text-sm text-slate-500 font-medium mb-10">{t.disclaimer}</p>

    <a href={homeHref} class="inline-flex items-center gap-2 text-accent font-semibold hover:underline">
      ← {t.backHome}
    </a>
  </main>
  <Footer />
</Layout>