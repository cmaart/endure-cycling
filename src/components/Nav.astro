---
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';
import { config } from '../config';
import BrowserIcon from './BrowserIcon.astro';

interface Props {
  lang?: 'en' | 'de';
  enPath: string;
  dePath: string;
  /** Sits over a full-bleed photo hero (homepage): transparent, light text. */
  overlay?: boolean;
}

// `lang` and the two locale paths come from Layout, which already normalizes
// `.html` suffixes away. Nav must not re-derive them.
const { lang = 'en', enPath, dePath, overlay = false } = Astro.props;
const t = getTranslations(lang).nav;
const isGerman = lang === 'de';
const home = localeHref(lang);

// Section anchors are absolute: Nav renders on every page now, and those
// sections only exist on the homepage. `#download` is the exception: it lives
// in the footer, so it resolves on every page.
const links = [
  { href: localeHref(lang, '/#features'), label: t.features },
  { href: localeHref(lang, '/features/zwift-click'), label: t.virtualShifting },
  { href: localeHref(lang, '/#trial'), label: t.trial },
  { href: localeHref(lang, '/guides'), label: t.guides },
  { href: localeHref(lang, '/#faq'), label: t.faq },
];
// Overlay variant: colour classes swap, layout stays the same.
const linkTone = overlay ? 'text-white/85 hover:text-white' : 'text-slate-600 hover:text-slate-900';
const onPhoto = overlay ? '!text-white !border-white/35 !bg-white/10 hover:!border-white/70' : '';
---

<nav class:list={['z-30 px-6 py-5 md:px-16 lg:px-10 xl:px-16 md:py-6', overlay ? 'absolute inset-x-0 top-0' : 'relative']}>
  <div class="flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href={home} class="flex items-center gap-2.5 shrink-0" aria-label="ENDURE">
      <img src={overlay ? '/assets/endure-mark-white.webp' : '/assets/endure-mark-black.webp'} alt="" width="34" height="34" class="w-[34px] h-[34px] object-contain" />
      <span class:list={['font-bold text-[19px] tracking-[0.12em]', overlay ? 'text-white' : 'text-slate-900']}>NDURE</span>
    </a>

    <!-- Links (desktop) -->
    <div class="hidden lg:flex gap-4 xl:gap-9 text-[15px] whitespace-nowrap">
      {links.map((link) => (
        <a href={link.href} class:list={[linkTone, 'transition-colors']}>{link.label}</a>
      ))}
    </div>

    <!-- Controls + CTA -->
    <div class="flex items-center gap-2.5 md:gap-3 shrink-0">
      <!--
        Language switch. The hrefs point at the current page's counterpart, not
        at the homepage, so switching language keeps you where you are and
        matches the hreflang pair Layout emits.
      -->
      <div class:list={['flex gap-1 rounded-full border backdrop-blur-md p-1 text-sm font-bold', overlay ? 'border-white/30 bg-white/10' : 'border-slate-200 bg-white/80']}>
        <a
          href={enPath}
          data-lang="en"
          class={`px-3 py-1.5 rounded-full transition-colors ${!isGerman ? (overlay ? 'bg-white text-slate-900' : 'bg-slate-900 text-white') : (overlay ? 'text-white/80 hover:text-white' : 'text-slate-500 hover:text-slate-800')}`}
        >EN</a>
        <a
          href={dePath}
          data-lang="de"
          class={`px-3 py-1.5 rounded-full transition-colors ${isGerman ? (overlay ? 'bg-white text-slate-900' : 'bg-slate-900 text-white') : (overlay ? 'text-white/80 hover:text-white' : 'text-slate-500 hover:text-slate-800')}`}
        >DE</a>
      </div>

      <!--
        Web app button. Full label from 1280 px and between 768 and 1023 px
        (where the desktop links sit in the strip below); icon-only between
        640 and 767 px (the German CTA is long) and between 1024 and 1279 px,
        where the link row needs the room. Below 640 px it
        stays visible beside the scrollable navigation.
      -->
      <a
        href={config.webApp.url}
        target="_blank"
        rel="noopener"
        data-placement="header"
        aria-label={t.webAppAria}
        class:list={['btn-secondary !hidden md:!inline-flex lg:!hidden xl:!inline-flex !px-4 xl:!px-5 !py-[11px] text-[15px] whitespace-nowrap', onPhoto]}
      >
        <BrowserIcon class="w-[17px] h-[17px] shrink-0" />
        {t.webApp}
      </a>
      <a
        href={config.webApp.url}
        target="_blank"
        rel="noopener"
        data-placement="header"
        aria-label={t.webAppAria}
        title={t.webApp}
        class:list={['btn-secondary !hidden sm:!inline-flex md:!hidden lg:!inline-flex xl:!hidden !p-0 w-[47px] h-[47px] !rounded-[14px]', onPhoto]}
      >
        <BrowserIcon class="w-[19px] h-[19px]" />
      </a>

      <!-- CTA (hidden on mobile; .btn-primary sets display, so gate via wrapper) -->
      <div class="hidden sm:block">
        <a href="#download" class="btn-primary !px-6 !py-3 text-[15px] whitespace-nowrap">{t.cta}</a>
      </div>
    </div>
  </div>

  <!--
    Below `lg` the desktop row is hidden and there was previously no way to
    reach any other page from the header. A horizontally scrollable strip keeps
    every link reachable without a hamburger and without extra JS.
  -->
  <div class="lg:hidden -mx-6 mt-4 md:-mx-16 flex items-center">
    <a
      href={config.webApp.url}
      target="_blank"
      rel="noopener"
      data-placement="header-mobile"
      aria-label={t.webAppAria}
      class:list={['sm:hidden shrink-0 ml-6 inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 text-[13px] font-bold whitespace-nowrap', overlay ? 'bg-white text-slate-900' : 'bg-slate-900 text-white']}
    >
      <BrowserIcon class="w-[15px] h-[15px] shrink-0" />
      {t.webApp}
    </a>
    <div class:list={['flex min-w-0 gap-6 overflow-x-auto px-6 py-2 pr-12 text-[14px]', overlay ? 'text-white/85' : 'text-slate-600', 'md:px-16']}>
      {links.map((link) => (
        <a href={link.href} class:list={['whitespace-nowrap transition-colors', overlay ? 'hover:text-white' : 'hover:text-slate-900']}>{link.label}</a>
      ))}
    </div>
  </div>
</nav>

<script>
  // Remember the chosen language so index.astro's redirect honours it.
  const langLinks = document.querySelectorAll('[data-lang]');

  langLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      const lang = (e.currentTarget as HTMLElement).dataset.lang;
      if (lang) {
        localStorage.setItem('preferredLang', lang);
      }
    });
  });
</script>
