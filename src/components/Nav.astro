---
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';
import { config } from '../config';
import BrowserIcon from './BrowserIcon.astro';

interface Props {
  lang?: 'en' | 'de';
  enPath: string;
  dePath: string;
}

// `lang` and the two locale paths come from Layout, which already normalizes
// `.html` suffixes away. Nav must not re-derive them.
const { lang = 'en', enPath, dePath } = Astro.props;
const t = getTranslations(lang).nav;
const isGerman = lang === 'de';
const home = localeHref(lang);

// Section anchors are absolute: Nav renders on every page now, and those
// sections only exist on the homepage. `#download` is the exception: it lives
// in the footer, so it resolves on every page.
const links = [
  { href: localeHref(lang, '/#features'), label: t.features },
  { href: localeHref(lang, '/features/zwift-click'), label: t.virtualShifting },
  { href: localeHref(lang, '/#trial'), label: t.trial },
  { href: localeHref(lang, '/guides'), label: t.guides },
  { href: localeHref(lang, '/#faq'), label: t.faq },
];
---

<nav class="relative z-30 px-6 py-5 md:px-16 lg:px-10 xl:px-16 md:py-6">
  <div class="flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href={home} class="flex items-center gap-2.5 shrink-0" aria-label="ENDURE">
      <span class="w-3 h-3 rounded-full bg-accent animate-pulse-glow"></span>
      <span class="font-bold text-[19px] tracking-[0.12em] text-slate-900">ENDURE</span>
    </a>

    <!-- Links (desktop) -->
    <div class="hidden lg:flex gap-4 xl:gap-9 text-[15px] text-slate-600 whitespace-nowrap">
      {links.map((link) => (
        <a href={link.href} class="hover:text-slate-900 transition-colors">{link.label}</a>
      ))}
    </div>

    <!-- Controls + CTA -->
    <div class="flex items-center gap-2.5 md:gap-3 shrink-0">
      <!--
        Language switch. The hrefs point at the current page's counterpart, not
        at the homepage, so switching language keeps you where you are and
        matches the hreflang pair Layout emits.
      -->
      <div class="flex gap-1 rounded-full border border-slate-200 bg-white/80 backdrop-blur-md p-1 text-sm font-bold">
        <a
          href={enPath}
          data-lang="en"
          class={`px-3 py-1.5 rounded-full transition-colors ${!isGerman ? 'bg-slate-900 text-white' : 'text-slate-500 hover:text-slate-800'}`}
        >EN</a>
        <a
          href={dePath}
          data-lang="de"
          class={`px-3 py-1.5 rounded-full transition-colors ${isGerman ? 'bg-slate-900 text-white' : 'text-slate-500 hover:text-slate-800'}`}
        >DE</a>
      </div>

      <!--
        Web app button. Full label from 1280 px and between 768 and 1023 px
        (where the desktop links sit in the strip below); icon-only between
        640 and 767 px (the German CTA is long) and between 1024 and 1279 px,
        where the link row needs the room. Below 640 px it
        moves into the link strip.
      -->
      <a
        href={config.webApp.url}
        target="_blank"
        rel="noopener"
        data-placement="header"
        aria-label={t.webAppAria}
        class="btn-secondary !hidden md:!inline-flex lg:!hidden xl:!inline-flex !px-4 xl:!px-5 !py-[11px] text-[15px] whitespace-nowrap"
      >
        <BrowserIcon class="w-[17px] h-[17px] shrink-0" />
        {t.webApp}
      </a>
      <a
        href={config.webApp.url}
        target="_blank"
        rel="noopener"
        data-placement="header"
        aria-label={t.webAppAria}
        title={t.webApp}
        class="btn-secondary !hidden sm:!inline-flex md:!hidden lg:!inline-flex xl:!hidden !p-0 w-[47px] h-[47px] !rounded-[14px]"
      >
        <BrowserIcon class="w-[19px] h-[19px]" />
      </a>

      <!-- CTA (hidden on mobile; .btn-primary sets display, so gate via wrapper) -->
      <div class="hidden sm:block">
        <a href="#download" class="btn-primary !px-6 !py-3 text-[15px] whitespace-nowrap">{t.cta}</a>
      </div>
    </div>
  </div>

  <!--
    Below `lg` the desktop row is hidden and there was previously no way to
    reach any other page from the header. A horizontally scrollable strip keeps
    every link reachable without a hamburger and without extra JS.
  -->
  <div class="lg:hidden -mx-6 mt-4 md:-mx-16">
    <div class="flex gap-6 overflow-x-auto px-6 pb-1 text-[14px] text-slate-600 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:px-16">
      {links.map((link) => (
        <a href={link.href} class="whitespace-nowrap hover:text-slate-900 transition-colors">{link.label}</a>
      ))}
      <!-- Below 640 px the header has no web app button, so it ends the strip. -->
      <a
        href={config.webApp.url}
        target="_blank"
        rel="noopener"
        data-placement="header-strip"
        aria-label={t.webAppAria}
        class="sm:hidden inline-flex items-center gap-1.5 whitespace-nowrap font-semibold text-slate-900 hover:text-accent transition-colors"
      >
        <BrowserIcon class="w-[15px] h-[15px] shrink-0" />
        {t.webApp}
      </a>
    </div>
  </div>
</nav>

<script>
  // Remember the chosen language so index.astro's redirect honours it.
  const langLinks = document.querySelectorAll('[data-lang]');

  langLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      const lang = (e.currentTarget as HTMLElement).dataset.lang;
      if (lang) {
        localStorage.setItem('preferredLang', lang);
      }
    });
  });
</script>
