---
import { getTranslations } from '../i18n/translations';
import { withPrices } from '../utils/prices';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).faq;
// Price answers carry {monthly}/{annual} placeholders; fill them once so the
// visible text and the JSON-LD agree.
const items: { q: string; a: string; highlight?: boolean }[] = t.items.map((item) => ({ ...item, a: withPrices(item.a, lang) }));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};
---

<section id="faq" class="py-24 relative">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-16" data-reveal>
        <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.02em] mb-4 text-slate-900">
          {t.title} <span class="text-accent">{t.titleHighlight}</span>
        </h2>
        <p class="text-slate-600 text-lg">
          {t.subtitle}
        </p>
      </div>

      <!-- Q&A list -->
      <div class="space-y-4">
        {items.map((item, idx) => (
          <div
            class:list={['card-surface p-6', item.highlight && '!border-accent/35']}
            data-reveal
            data-reveal-delay={Math.min(idx, 3) * 100}
          >
            <h3 class="text-lg font-bold text-slate-900 mb-2">{item.q}</h3>
            <p class="text-slate-600 leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Structured Data (JSON-LD) — FAQ answers for answer engines / rich results -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>