---
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).zwiftClick;
---

<section id="zwift-click" class="py-20 md:py-28 relative overflow-hidden">
  <!-- Accent glow, top-left -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-32 -left-36 w-[600px] h-[500px] bg-[radial-gradient(ellipse_at_center,rgba(194,85,43,0.04),transparent_70%)]"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-5xl mx-auto">

    <!-- Two-column layout: text left, image right -->
    <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16">

      <!-- Left: Text content -->
      <div class="flex-1 text-center lg:text-left" data-reveal="left">
        <div class="inline-flex items-center gap-2 mono-label uppercase border border-accent/30 rounded-full px-4 py-1.5 mb-6">
          <span class="inline-block w-2 h-2 bg-accent rounded-full animate-pulse"></span>
          {t.badge}
        </div>

        <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.02em] mb-4 leading-[1.1] text-slate-900 text-balance">
          {t.headline1}<br/>
          <span class="text-accent">{t.headline2}</span>
        </h2>

        <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-6">
          {t.description}
        </p>

        <!-- Bullet points -->
        <ul class="space-y-3 text-left">
          {t.bullets.map((bullet: string) => (
            <li class="flex items-start gap-3">
              <span class="mt-[9px] flex-shrink-0 w-1.5 h-1.5 rounded-full bg-accent"></span>
              <span class="text-slate-600" set:html={bullet}></span>
            </li>
          ))}
        </ul>

        <!-- Link into the feature landing that expands on this section -->
        <a href={localeHref(lang, '/features/zwift-click')} class="inline-flex items-center gap-2 mt-7 text-accent font-semibold hover:underline">
          {t.moreLink} →
        </a>
      </div>

      <!-- Right: Marketing render -->
      <div class="flex-1 w-full max-w-lg mx-auto lg:mx-0" data-reveal="right">
        <img
          src="/assets/zwift_click/zwift_click_landscape.min.webp"
          alt={t.imageAlt}
          loading="lazy"
          class="relative w-full h-auto rounded-3xl shadow-[0_30px_80px_rgba(22,24,29,0.14)] border border-slate-200"
        />
      </div>

    </div>
    </div>
  </div>
</section>
