---
import { getTranslations } from '../i18n/translations';
import FeatureCard from './FeatureCard.astro';
import { localeHref } from '../utils/paths';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).features;
const screens = getTranslations(lang).appScreens;

/*
 * The captioned screenshots below the feature cards. Alt text and captions come
 * from the shared appScreens map, so the hero carousel and this showcase never
 * drift apart. The screens listed here are the ones that read cleanly at this
 * size — the rest of the set stays in the carousel.
 */
const screenshots = [
  { src: '/assets/app/ride_screen.webp', ...screens.ride },
  { src: '/assets/app/vo2max_detail.webp', ...screens.vo2max },
  { src: '/assets/app/time_in_zones.webp', ...screens.zones },
  { src: '/assets/app/ai_coaching.webp', ...screens.coaching },
  { src: '/assets/app/activity_detail.webp', ...screens.activity },
];
---

<section id="features" class="py-24 relative">
  <div class="container mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16" data-reveal>
      <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.02em] mb-4 text-slate-900">
        {t.sectionTitle} <span class="text-accent">{t.sectionTitleHighlight}</span>
      </h2>
      <p class="text-slate-600 text-lg max-w-xl mx-auto">
        {t.sectionSubtitle}
      </p>

      <!-- Links into the pages that expand on the two most-searched topics here -->
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-6 text-sm font-semibold">
        <a href={localeHref(lang, '/features/ftp-vo2max-tracking')} class="text-accent hover:underline">
          {t.analyticsLink} →
        </a>
        <a href={localeHref(lang, '/supported-trainers')} class="text-accent hover:underline">
          {t.trainersLink} →
        </a>
      </div>
    </div>

    <!-- Feature Grid -->
    <div class="grid md:grid-cols-2 gap-5">
      <!-- Fast & Rock-Solid -->
      <div data-reveal>
        <FeatureCard
          title={t.performance.title}
          stat="< 30 s"
          features={[
            t.performance.feature1,
            t.performance.feature2,
            t.performance.feature3
          ]}
        />
      </div>

      <!-- Deep Progress Analytics -->
      <div data-reveal data-reveal-delay="100">
        <FeatureCard
          title={t.analytics.title}
          stat="FTP · VO2"
          features={[
            t.analytics.feature1,
            t.analytics.feature2,
            t.analytics.feature3
          ]}
        />
      </div>

      <!-- Structured Training -->
      <div data-reveal data-reveal-delay="200">
        <FeatureCard
          title={t.training.title}
          stat="ERG"
          features={[
            t.training.feature1,
            t.training.feature2,
            t.training.feature3
          ]}
        />
      </div>

      <!-- Connectivity & Sync -->
      <div data-reveal data-reveal-delay="300">
        <FeatureCard
          title={t.connectivity.title}
          stat="BLE"
          features={[
            t.connectivity.feature1,
            t.connectivity.feature2,
            t.connectivity.feature3,
            t.connectivity.feature4
          ]}
        />
      </div>
    </div>

    <!-- Screenshot showcase -->
    <div class="mt-20 mx-auto max-w-[900px] flex flex-wrap justify-center gap-x-8 gap-y-12">
      {screenshots.map((shot, idx) => (
        <div class="w-[240px] md:w-[260px]" data-reveal data-reveal-delay={idx % 2 === 1 ? 100 : undefined}>
          <img
            src={shot.src}
            alt={shot.alt}
            width="260"
            height="569"
            loading="lazy"
            decoding="async"
            data-zoomable
            class="relative rounded-2xl border border-slate-200 shadow-xl shadow-slate-200/50 w-full cursor-zoom-in hover:shadow-2xl transition-shadow"
          />
          <p class="text-center mt-4 text-slate-600 text-sm">{shot.caption}</p>
        </div>
      ))}
    </div>
  </div>
</section>