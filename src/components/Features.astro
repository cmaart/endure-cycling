---
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';
import { appShotDir } from '../utils/appShots';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).features;
const screens = getTranslations(lang).appScreens;

/*
 * The captioned screenshots below the feature cards. Alt text and captions come
 * from the shared appScreens map, so the hero carousel and this showcase never
 * drift apart. The screens listed here are the ones that read cleanly at this
 * size. The rest of the set stays in the carousel.
 */
const app = appShotDir(lang);
const groups = [
  { title: t.performance.title, items: [t.performance.feature1, t.performance.feature2, t.performance.feature3] },
  { title: t.analytics.title, items: [t.analytics.feature1, t.analytics.feature2, t.analytics.feature3] },
  { title: t.training.title, items: [t.training.feature1, t.training.feature2, t.training.feature3] },
  { title: t.connectivity.title, items: [t.connectivity.feature1, t.connectivity.feature2, t.connectivity.feature3, t.connectivity.feature4] },
];

const screenshots = [
  { src: `${app}/ride_screen.webp`, ...screens.ride },
  { src: `${app}/vo2max_detail.webp`, ...screens.vo2max },
  { src: `${app}/time_in_zones.webp`, ...screens.zones },
  { src: `${app}/ai_coaching.webp`, ...screens.coaching },
  { src: `${app}/activity_detail.webp`, ...screens.activity },
];
---

<section id="features" class="py-20 md:py-28 relative">
  <div class="page-container">
    <!-- Section Header -->
    <div class="text-center mb-16" data-reveal>
      <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.02em] mb-4 text-slate-900">
        {t.sectionTitle} <span class="text-accent">{t.sectionTitleHighlight}</span>
      </h2>
      <p class="text-slate-600 text-lg max-w-xl mx-auto">
        {t.sectionSubtitle}
      </p>

      <!-- Links into the pages that expand on the two most-searched topics here -->
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-6 text-sm font-semibold">
        <a href={localeHref(lang, '/features/ftp-vo2max-tracking')} class="text-accent hover:underline">
          {t.analyticsLink} →
        </a>
        <a href={localeHref(lang, '/supported-trainers')} class="text-accent hover:underline">
          {t.trainersLink} →
        </a>
      </div>
    </div>

    <!-- Feature list: ruled rows, one group per row -->
    <div class="border-t border-slate-200">
      {groups.map((group) => (
        <div class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-4 md:gap-12 py-8 md:py-10 border-b border-slate-200">
          <h3 class="text-xl md:text-2xl font-bold tracking-[-0.01em] text-slate-900">{group.title}</h3>
          <ul class="feature-list grid sm:grid-cols-2 gap-x-10 gap-y-3">
            {group.items.map((item) => (
              <li class="text-slate-600 text-[15px] leading-relaxed">
                <span set:html={item} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Screenshot showcase -->
    <div class="mt-20 mx-auto max-w-[900px] flex flex-wrap justify-center gap-x-8 gap-y-12" data-reveal>
      {screenshots.map((shot) => (
        <div class="w-[240px] md:w-[260px]">
          <img
            src={shot.src}
            alt={shot.alt}
            width="260"
            height="569"
            loading="lazy"
            decoding="async"
            data-zoomable
            class="relative rounded-2xl border border-slate-200 shadow-xl shadow-slate-200/50 w-full cursor-zoom-in hover:shadow-2xl transition-shadow"
          />
          <p class="text-center mt-4 text-slate-600 text-sm">{shot.caption}</p>
        </div>
      ))}
    </div>
  </div>
</section>