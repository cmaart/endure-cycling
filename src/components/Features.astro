---
import { getTranslations } from '../i18n/translations';
import FeatureCard from './FeatureCard.astro';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).features;

const screenshots = [
  { src: '/assets/screenshots/builtin_workouts.min.webp', alt: 'ENDURE Workout Library', caption: t.screenshot1Caption },
  { src: '/assets/screenshots/imported_workouts.min.webp', alt: 'ENDURE Import Workouts', caption: t.screenshot2Caption },
  { src: '/assets/screenshots/2026-01-25 10_28_53-Endure.min.min.webp', alt: 'ENDURE Power Profile', caption: t.screenshot3Caption },
  { src: '/assets/screenshots/the_ride.min.min.webp', alt: 'ENDURE Ride Screen', caption: t.screenshot4Caption },
  { src: '/assets/screenshots/smart_smoothing.min.webp', alt: 'ENDURE Smart Smoothing', caption: t.screenshot5Caption },
  { src: '/assets/ZoneDistribution.min.webp', alt: 'ENDURE Time in Zones', caption: t.screenshot6Caption },
];
---

<section id="features" class="py-24 relative">
  <div class="container mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16" data-reveal>
      <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.02em] mb-4 text-slate-900">
        {t.sectionTitle} <span class="text-accent">{t.sectionTitleHighlight}</span>
      </h2>
      <p class="text-slate-600 text-lg max-w-xl mx-auto">
        {t.sectionSubtitle}
      </p>
    </div>

    <!-- Feature Grid -->
    <div class="grid md:grid-cols-2 gap-5">
      <!-- Fast & Rock-Solid -->
      <div data-reveal>
        <FeatureCard
          title={t.performance.title}
          stat="< 30 s"
          features={[
            t.performance.feature1,
            t.performance.feature2,
            t.performance.feature3
          ]}
        />
      </div>

      <!-- Deep Progress Analytics -->
      <div data-reveal data-reveal-delay="100">
        <FeatureCard
          title={t.analytics.title}
          stat="FTP · VO2"
          features={[
            t.analytics.feature1,
            t.analytics.feature2,
            t.analytics.feature3
          ]}
        />
      </div>

      <!-- Structured Training -->
      <div data-reveal data-reveal-delay="200">
        <FeatureCard
          title={t.training.title}
          stat="ERG"
          features={[
            t.training.feature1,
            t.training.feature2,
            t.training.feature3
          ]}
        />
      </div>

      <!-- Connectivity & Sync -->
      <div data-reveal data-reveal-delay="300">
        <FeatureCard
          title={t.connectivity.title}
          stat="BLE"
          features={[
            t.connectivity.feature1,
            t.connectivity.feature2,
            t.connectivity.feature3
          ]}
        />
      </div>
    </div>

    <!-- Screenshot showcase -->
    <div class="mt-20 grid md:grid-cols-2 gap-8">
      {screenshots.map((shot, idx) => (
        <div class="relative group" data-reveal data-reveal-delay={idx % 2 === 1 ? 100 : undefined}>
          <img
            src={shot.src}
            alt={shot.alt}
            data-zoomable
            class="relative rounded-2xl border border-slate-200 shadow-xl shadow-slate-200/50 w-full cursor-zoom-in hover:shadow-2xl transition-shadow"
          />
          <p class="text-center mt-4 text-slate-600 text-sm">{shot.caption}</p>
        </div>
      ))}
    </div>
  </div>
</section>