---
import { getTranslations } from '../i18n/translations';
import { getPricing } from '../utils/prices';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).trial;
const pricing = getPricing(lang);

// The price line bolds the two amounts, so the placeholders become markup
// rather than going through the plain-text withPrices().
const strong = (label: string) => `<span class="font-semibold text-slate-700 whitespace-nowrap">${label}</span>`;
const priceLine = t.priceLine
  .replace('{monthly}', strong(pricing.monthlyLabel))
  .replace('{annual}', strong(pricing.annualLabel));
---

<section id="trial" class="py-24 px-6 md:px-16 relative scroll-mt-8">
  <div class="max-w-[1120px] mx-auto">
    <div class="text-center mb-14" data-reveal>
      <div class="font-mono text-[13px] tracking-[0.04em] text-accent mb-4">{t.eyebrow}</div>
      <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.02em] mb-4 text-slate-900 text-balance">
        {t.title} <span class="text-accent">{t.titleHighlight}</span>
      </h2>
      <p class="mx-auto max-w-[600px] text-lg leading-relaxed text-slate-600 text-pretty">{t.intro}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-5 items-stretch">
      <!-- The 14 -->
      <div data-reveal class="bg-slate-900 text-endure-bg-primary rounded-[20px] p-9 flex flex-col justify-between gap-8 min-h-80">
        <div>
          <div class="font-extrabold text-[96px] lg:text-[132px] leading-[0.9] tracking-[-0.05em]" aria-hidden="true">14</div>
          <div class="font-bold text-[22px] mt-2"><span class="sr-only">14 </span>{t.cardTitle}</div>
          <p class="mt-3 text-[15px] leading-relaxed text-slate-300">{t.cardText}</p>
        </div>
        <div class="flex items-center gap-2.5 font-mono text-[13px] text-[#E07A52]">
          <span class="w-2 h-2 rounded-full bg-[#E07A52]"></span>
          {t.cardFoot}
        </div>
      </div>

      <!-- Day by day -->
      <ol data-reveal data-reveal-delay="100" class="card-surface p-9 flex flex-col gap-7">
        {t.steps.map((step) => (
          <li class="grid grid-cols-[auto_1fr] gap-4 items-start">
            <div class="font-mono text-[13px] text-accent pt-1 min-w-14">{step.day}</div>
            <div>
              <div class="font-bold text-[17px] text-slate-900 mb-1">{step.title}</div>
              <div class="text-sm leading-relaxed text-slate-600">{step.text}</div>
            </div>
          </li>
        ))}
      </ol>

      <!-- What you don't need -->
      <div data-reveal data-reveal-delay="200" class="card-surface p-9 flex flex-col gap-6">
        <h3 class="text-xl font-bold text-slate-900">{t.notsTitle}</h3>
        <ul class="flex flex-col gap-3.5">
          {t.nots.map((item) => (
            <li class="flex items-center gap-3 text-[15px] text-slate-700">
              <span class="w-[22px] h-[22px] shrink-0 rounded-full border border-slate-300 inline-flex items-center justify-center text-xs text-slate-500" aria-hidden="true">✕</span>
              <span class="line-through decoration-accent/60">{item}</span>
            </li>
          ))}
        </ul>
        <a href="#download" class="btn-trial mt-auto">{t.cta}</a>
      </div>
    </div>

    <p id="pricing" class="mt-7 px-6 py-4 text-sm text-slate-500 text-center" data-reveal set:html={priceLine} />
  </div>
</section>

<style>
  .btn-trial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 28px;
    border-radius: 14px;
    background: var(--color-accent);
    color: var(--color-endure-bg-primary);
    font-weight: 700;
    font-size: 16px;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .btn-trial:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(194, 85, 43, 0.3);
  }
</style>
