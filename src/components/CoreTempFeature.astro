---
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';
import { appShotDir } from '../utils/appShots';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).coreTemp;

// Illustrative heat-zone scale rendered in CSS, so it needs no screenshot.
const zones = [
  { label: '<37.0°', color: '#38bdf8' },
  { label: '37.0°', color: '#4ade80' },
  { label: '37.5°', color: '#facc15' },
  { label: '38.0°', color: '#fb923c' },
  { label: '38.5°+', color: '#ef4444' },
];
---

<section id="core-temp" class="py-20 md:py-28 relative overflow-hidden">
  <div class="page-container relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">

      <!-- Left: copy, scale, bullets -->
      <div class="flex-1 min-w-0 text-center lg:text-left" data-reveal>
        <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.02em] mb-4 leading-[1.1] text-slate-900 text-balance">
          {t.headline1}{' '}
          <span class="text-accent">{t.headline2}</span>
        </h2>

        <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-7">
          {t.description}
        </p>

        <!-- Heat-zone scale -->
        <div class="mb-8">
          <div class="flex rounded-full overflow-hidden h-3">
            {zones.map((z) => (
              <div class="flex-1" style={`background-color: ${z.color}`}></div>
            ))}
          </div>
          <div class="flex mt-2">
            {zones.map((z) => (
              <div class="flex-1 text-center text-xs font-semibold text-slate-600">{z.label}</div>
            ))}
          </div>
        </div>

        <ul class="feature-list space-y-3 text-left">
          {t.bullets.map((bullet: string) => (
            <li class="text-slate-600" set:html={bullet}></li>
          ))}
        </ul>

        <a href={localeHref(lang, '/features/core-heat-zones')} class="inline-flex items-center gap-2 mt-7 text-accent font-semibold hover:underline">
          {t.moreLink} →
        </a>
      </div>

      <!-- Right: the ride screen with live core temperature and heat zone -->
      <div class="w-[260px] md:w-[300px] shrink-0" data-reveal>
        <div class="phone-frame rounded-[36px]">
          <img
            src={`${appShotDir(lang)}/core_heat_screen.webp`}
            alt={t.imageAlt}
            width="1080"
            height="2364"
            loading="lazy"
            decoding="async"
            data-zoomable
            class="w-full h-auto cursor-zoom-in"
          />
        </div>
      </div>

    </div>
  </div>
</section>
