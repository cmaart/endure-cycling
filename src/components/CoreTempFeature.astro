---
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).coreTemp;

// Illustrative heat-zone scale rendered in CSS — no screenshot dependency.
const zones = [
  { label: '<37.0°', color: '#38bdf8' },
  { label: '37.0°', color: '#4ade80' },
  { label: '37.5°', color: '#facc15' },
  { label: '38.0°', color: '#fb923c' },
  { label: '38.5°+', color: '#ef4444' },
];
---

<section id="core-temp" class="py-16 relative overflow-hidden">
  <!-- Subtle cyan/red gradient blob — heat theme, distinct from lactate + climbing sections -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-gradient-to-br from-[#38bdf8]/12 via-[#fb923c]/10 to-[#ef4444]/8 rounded-full blur-3xl"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-5xl mx-auto">

      <!-- Industry-first badge -->
      <div class="flex justify-center mb-6" data-reveal>
        <span class="inline-flex items-center gap-2.5 font-mono text-[13px] tracking-[0.04em] uppercase text-[#ef4444] border border-[#ef4444]/30 rounded-full px-4 py-1.5">
          <span class="inline-block w-2 h-2 bg-[#ef4444] rounded-full animate-pulse"></span>
          {t.badge}
        </span>
      </div>

      <!-- Headline -->
      <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.02em] mb-4 leading-[1.1] text-center text-slate-900 text-balance" data-reveal data-reveal-delay="100">
        {t.headline1}<br/>
        <span class="text-accent">{t.headline2}</span>
      </h2>

      <!-- Description -->
      <p class="text-base md:text-lg text-slate-600 leading-relaxed text-center max-w-3xl mx-auto mb-8" data-reveal data-reveal-delay="200">
        {t.description}
      </p>

      <!-- Stat highlights -->
      <div class="grid grid-cols-2 gap-3 max-w-md mx-auto mb-8" data-reveal data-reveal-delay="300">
        <div class="card-surface hover-lift p-4 text-center">
          <div class="text-xl font-bold text-[#ef4444] mb-1">{t.stat1Title}</div>
          <div class="text-xs text-slate-600 font-medium">{t.stat1Sub}</div>
        </div>
        <div class="card-surface hover-lift p-4 text-center">
          <div class="text-xl font-bold text-[#fb923c] mb-1">{t.stat2Title}</div>
          <div class="text-xs text-slate-600 font-medium">{t.stat2Sub}</div>
        </div>
      </div>

      <!-- Heat-zone scale -->
      <div class="max-w-2xl mx-auto mb-10" data-reveal data-reveal-delay="350">
        <div class="flex rounded-full overflow-hidden h-3 shadow-inner">
          {zones.map((z) => (
            <div class="flex-1" style={`background-color: ${z.color}`}></div>
          ))}
        </div>
        <div class="flex mt-2">
          {zones.map((z) => (
            <div class="flex-1 text-center text-xs font-semibold text-slate-500">{z.label}</div>
          ))}
        </div>
      </div>

      <!-- Bullets -->
      <ul class="space-y-3 max-w-2xl mx-auto" data-reveal data-reveal-delay="400">
        {t.bullets.map((bullet: string) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-[#ef4444]/10 border border-[#ef4444]/30 flex items-center justify-center">
              <svg class="w-3 h-3 text-[#ef4444]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="text-slate-600 font-medium" set:html={bullet}></span>
          </li>
        ))}
      </ul>

      <!-- Link into the feature landing that expands on this section -->
      <div class="text-center mt-8">
        <a href={localeHref(lang, '/features/core-heat-zones')} class="inline-flex items-center gap-2 text-accent font-semibold hover:underline">
          {t.moreLink} →
        </a>
      </div>

    </div>
  </div>
</section>