---
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).proof;
const trainersHref = localeHref(lang, '/supported-trainers');
---

<section id="proof" class="py-20 md:py-28">
  <div class="page-container">
    <div data-reveal class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)_minmax(0,1fr)] gap-5 items-stretch">
      <!-- Store rating -->
      <div class="card-surface p-8 flex flex-col justify-between gap-6">
        <div>
          <div class="flex items-baseline gap-3">
            <span class="font-extrabold text-[64px] leading-none tracking-[-0.04em] text-slate-900">{t.ratingValue}</span>
            <span class="flex gap-0.5" aria-hidden="true"><svg class="w-5 h-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6 .7-4.5 4.1 1.2 6L10 14.9 4.7 17.9l1.2-6L1.4 7.8l6-.7z"/></svg><svg class="w-5 h-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6 .7-4.5 4.1 1.2 6L10 14.9 4.7 17.9l1.2-6L1.4 7.8l6-.7z"/></svg><svg class="w-5 h-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6 .7-4.5 4.1 1.2 6L10 14.9 4.7 17.9l1.2-6L1.4 7.8l6-.7z"/></svg><svg class="w-5 h-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6 .7-4.5 4.1 1.2 6L10 14.9 4.7 17.9l1.2-6L1.4 7.8l6-.7z"/></svg><svg class="w-5 h-5 text-accent" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6 .7-4.5 4.1 1.2 6L10 14.9 4.7 17.9l1.2-6L1.4 7.8l6-.7z"/></svg></span>
          </div>
          <div class="mt-4 font-bold text-[17px] text-slate-900">{t.ratingLabel}</div>
          <div class="text-sm text-slate-600">{t.ratingCount}</div>
        </div>
        <div class="font-mono text-xs text-slate-600">{t.ratingChecked}</div>
      </div>

      <!-- Review quote -->
      <figure class="card-surface p-8 flex flex-col justify-between gap-6">
        <blockquote class="text-lg md:text-xl leading-relaxed text-slate-800 text-pretty">
          <span class="text-accent font-serif text-3xl leading-none align-top mr-1" aria-hidden="true">“</span>{t.quote}
        </blockquote>
        <figcaption class="text-sm text-slate-600">{t.quoteSource}</figcaption>
      </figure>

      <!-- Trainer compatibility -->
      <div class="card-surface p-8 flex flex-col justify-between gap-6">
        <div>
          <div class="font-bold text-[17px] text-slate-900 mb-2">{t.trainersTitle}</div>
          <p class="text-sm leading-relaxed text-slate-600">{t.trainersText}</p>
        </div>
        <a href={trainersHref} class="text-accent font-semibold text-sm hover:underline">{t.trainersLink} →</a>
      </div>
    </div>
  </div>
</section>
