---
import { getTranslations } from '../i18n/translations';
import { localeHref } from '../utils/paths';

const lang = Astro.currentLocale as 'en' | 'de' || 'en';
const t = getTranslations(lang).proof;
const aboutHref = localeHref(lang, '/about');
---

<section id="proof" class="py-20 px-6 md:px-16">
  <div class="max-w-[1120px] mx-auto">
    <div class="font-mono text-[13px] tracking-[0.04em] text-accent mb-8 text-center" data-reveal>{t.eyebrow}</div>

    <div class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)_minmax(0,1fr)] gap-5 items-stretch">
      <!-- Store rating -->
      <div data-reveal class="card-surface p-8 flex flex-col justify-between gap-6">
        <div>
          <div class="flex items-baseline gap-3">
            <span class="font-extrabold text-[64px] leading-none tracking-[-0.04em] text-slate-900">{t.ratingValue}</span>
            <span class="text-accent text-xl tracking-[0.1em]" aria-hidden="true">★★★★★</span>
          </div>
          <div class="mt-4 font-bold text-[17px] text-slate-900">{t.ratingLabel}</div>
          <div class="text-sm text-slate-600">{t.ratingCount}</div>
        </div>
        <div class="font-mono text-xs text-slate-500">{t.ratingChecked}</div>
      </div>

      <!-- Review quote -->
      <figure data-reveal data-reveal-delay="100" class="card-surface p-8 flex flex-col justify-between gap-6">
        <blockquote class="text-lg md:text-xl leading-relaxed text-slate-800 text-pretty">
          <span class="text-accent font-serif text-3xl leading-none align-top mr-1" aria-hidden="true">“</span>{t.quote}
        </blockquote>
        <figcaption class="text-sm text-slate-500">{t.quoteSource}</figcaption>
      </figure>

      <!-- Founder -->
      <div data-reveal data-reveal-delay="200" class="card-surface p-8 flex flex-col justify-between gap-6">
        <div>
          <div class="font-bold text-[17px] text-slate-900 mb-2">{t.founderTitle}</div>
          <p class="text-sm leading-relaxed text-slate-600">{t.founderText}</p>
        </div>
        <a href={aboutHref} class="text-accent font-semibold text-sm hover:underline">{t.founderLink} →</a>
      </div>
    </div>
  </div>
</section>
